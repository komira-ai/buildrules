load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# toolbox (README.md): the small programs a test expects on its PATH (rm, mkdir, sleep, echo, cat, env, printenv, true, false) as one static
# Zig executable, built by the pinned zig behind its unit tests. Only the gate stand-ins of ci/mojo_gate run it so far (README.md).
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_exe_target_test", "zig_test")

# Zig 0.15 code (std.Io, ArrayList.empty): it builds with the pinned zig_next, as kpin and the command line do.
_ZIG = "buildrules//rules/pins:zig_next"
_ZIG_VERSION = "buildrules//rules/pins:zig_next_version"

_SRCS = [
    "files.zig",
    "io.zig",
    "procs.zig",
    "text.zig",
    "toolbox.zig",
]

# Unit tests: every applet in-process, with the streams, the clock and the spawner as buffers and records.
zig_test(
    name = "toolbox_unit",
    src = "toolbox_test.zig",
    imports = _SRCS + ["testkit.zig"],
    zig = _ZIG,
)

# The executable, built only when the unit tests passed.
zig_exe(
    name = "toolbox",
    src = "toolbox.zig",
    imports = _SRCS,
    unit_tests = [":toolbox_unit", _ZIG_VERSION],
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The same program for the other hosts, cross-compiled by the one zig (no SDK is needed), behind the same tests.
_NATIVE = {
    "linux_aarch64": "aarch64-linux-musl",
    "macos_arm64": "aarch64-macos",
}

[
    zig_exe(
        name = "toolbox_" + name,
        src = "toolbox.zig",
        imports = _SRCS,
        target = triple,
        unit_tests = [":toolbox_unit", _ZIG_VERSION],
        zig = _ZIG,
        visibility = ["PUBLIC"],
    )
    for name, triple in _NATIVE.items()
]

zig_exe_target_test(name = "linux_aarch64_is_aarch64_linux_musl", exe = ":toolbox_linux_aarch64", expect = "aarch64-linux-musl", same_tests_as = ":toolbox", visibility = ["PUBLIC"])

zig_exe_target_test(name = "macos_arm64_is_aarch64_macos", exe = ":toolbox_macos_arm64", expect = "aarch64-macos", same_tests_as = ":toolbox", visibility = ["PUBLIC"])

# The executable as a process (toolbox_exe_test.zig): the applet chosen by a link's name, the real clock, stdin, stdout and environment, and the real
# start of a child by `env`. A validation of `:toolbox`; it adds nothing to the coverage.
zig_test(
    name = "toolbox_exe_test",
    src = "toolbox_exe_test.zig",
    imports = _SRCS + ["testkit.zig"],
    env_tools = {"TOOLBOX": ":toolbox"},
    visibility = ["PUBLIC"],
    zig = _ZIG,
)

# The coverage of the sources the unit tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to. `main`, `realSleep` and
# `realSpawn` are compiled into no unit test (the process test runs them), so they have neither lines nor blocks there.
zig_coverage(
    test_targets = [":toolbox_unit"],
    expect = ["rules/toolbox/" + f for f in _SRCS],
)

scrub_files()
