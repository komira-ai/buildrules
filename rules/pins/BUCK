load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The pinned downloads and unpacked tools every family of this directory shares: busybox (`sh` and
# the file utilities of every action), zig (the C link driver, and the compiler of the Zig tools),
# zig 0.15.2 and the conda runtime libraries. Values in pins.bzl.
load("//rules/core:pinned_file.bzl", "pinned_file")
load("//rules/core:platform.bzl", "MACOS_AARCH64", "TOOL_EXEC", "by_os_cpu")
load("//rules/core:unpack.bzl", "unpack_refused")
load("//rules/zig:zig.bzl", "zig_bootstrap_exe", "zig_dist", "zig_test")
load("//rules:matrix.bzl", "group")
load(":bootstrap.bzl", "UNPACK_PINS")
load(":hosts.bzl", "HOST_PINS", "host_downloads")
load(":pins.bzl", "PINS", "strip_prefix")
load(":tool_zig.bzl", "tool_zig")

# On a Mac that runs Buck2 itself (`[buildrules_re] mode = local`, rules/core/platform.bzl: TOOL_EXEC) the tool tier runs on the Mac: its zig is the macOS
# archive of the same release (hosts.bzl), unpacked by the pinned `unpack` program, and its busybox is the Zig program `macos_applets` (macos_applets.zig), which
# is built by that zig. On a farm none of this exists and the targets below are what they always were.
_LOCAL_MAC = TOOL_EXEC == MACOS_AARCH64

[
    pinned_file(
        name = p["name"],
        url = p["url"],
        sha256 = p["sha256"],
        size_bytes = p["size"],
        executable = p.get("executable", False),
        visibility = ["PUBLIC"],
    )
    for p in PINS.values()
    if not (_LOCAL_MAC and p["name"] == "busybox")
]

zig_dist(
    name = "zig",
    visibility = ["PUBLIC"],
    **tool_zig("zig", _LOCAL_MAC)
)

zig_dist(
    name = "zig_next",
    visibility = ["PUBLIC"],
    **tool_zig("zig_next", _LOCAL_MAC)
)

# The applets of a Mac (macos_applets.zig). The program is built by the pinned zig without a shell, so it can exist before any busybox does. Its tests need a busybox to run:
# the farm and every Linux machine run them before the program they gate is built (cross-compiled for macOS there as well, so the tree holds it whether or not a Mac is
# building). On a Mac the busybox IS this program, so it cannot wait for tests that need it: it is built unchecked, the tests are a target of their own, and the farm's run of
# the same source is what gates it.
zig_test(
    name = "macos_applets_unit",
    src = "macos_applets_test.zig",
    imports = ["macos_applets.zig"],
    busybox = ":busybox",
    zig = ":zig",
    visibility = ["PUBLIC"],
)

zig_bootstrap_exe(
    name = "macos_applets",
    src = "macos_applets.zig",
    target = "aarch64-macos",
    unit_tests = [] if _LOCAL_MAC else [":macos_applets_unit"],
    zig = ":zig",
    visibility = ["PUBLIC"],
)

[
    alias(name = "busybox", actual = ":macos_applets", visibility = ["PUBLIC"])
    for _ in [1]
    if _LOCAL_MAC
]

# `:zig_next` reports 0.15.2. Compiled and run by the 0.12 zig, so it does not depend on what it
# checks. A target built with `:zig_next` lists this test in its `unit_tests`.
zig_test(
    name = "zig_next_version",
    exec_compatible_with = TOOL_EXEC,
    env_tools = {"ZIG_NEXT": ":zig_next"},
    src = "zig_next_version_test.zig",
    busybox = ":busybox",
    zig = ":zig",
    visibility = ["PUBLIC"],
)

# Read by the buildrules.dev site tests (site/BUCK), which check the Zig versions the pages state.
export_file(
    name = "pins.bzl",
    src = "pins.bzl",
    visibility = ["//site:", "//ci:"],
)

# Read by ci/pin_mirrors_check.zig, which checks the hosts of every download.
export_file(
    name = "hosts.bzl",
    src = "hosts.bzl",
    visibility = ["//ci:"],
)


# ---- the other hosts (hosts.bzl) -----------------------------------------------------------------
# Downloads of linux-aarch64 and macos-aarch64: zig, node, rustc and its components. Nothing unpacks them yet (hosts.bzl says why); each is
# a download buck2 verifies against the sha256 and the size, so `host_downloads` is the check that the table is right. It needs no execution
# platform of its own, so it builds on the farm and on every runner.
[
    pinned_file(
        name = h + "__" + d["name"],
        url = d["url"],
        sha256 = d["sha256"],
        size_bytes = d["size"],
        visibility = ["PUBLIC"],
    )
    for h in HOST_PINS
    for d in host_downloads(h)
]

[
    group(
        name = "host_downloads_" + h.replace("-", "_"),
        deps = [":" + h + "__" + d["name"] for d in host_downloads(h)],
        visibility = ["PUBLIC"],
    )
    for h in HOST_PINS
]

group(
    name = "host_downloads",
    deps = [":host_downloads_" + h.replace("-", "_") for h in HOST_PINS],
    visibility = ["PUBLIC"],
)

# ---- unpack, the program that unpacks the rest (bootstrap.bzl) --------------------------------------------------------------------------------------------------
# One pinned release asset per host, the program every unpacking action runs (`:unpack`, below, picks the one of the execution platform). The assets are published by
# .github/workflows/publish-unpack.yml, and //ci:unpack_pin_check holds the rows to the programs the tree builds.
[
    pinned_file(
        name = "bootstrap_unpack_" + host.replace("-", "_"),
        url = row["url"],
        sha256 = row["sha256"],
        size_bytes = row["size"],
        executable = True,
        visibility = ["PUBLIC"],
    )
    for host, row in UNPACK_PINS.items()
]

# The `unpack` an action runs is the one pinned for its execution platform: every rule that unpacks an archive takes `//rules/pins:unpack` as an `exec_dep`
# (rules/core/unpack.bzl). A platform with no pin takes `unpack_refused`, which fails analysis naming the platform, so no rule falls back to another way to unpack.
unpack_refused(
    name = "unpack_refused",
    hosts = sorted(UNPACK_PINS.keys()),
)

alias(
    name = "unpack",
    actual = by_os_cpu({
        "linux_x86_64": ":bootstrap_unpack_linux_x86_64",
        "linux_aarch64": ":bootstrap_unpack_linux_aarch64",
        "macos_aarch64": ":bootstrap_unpack_macos_aarch64",
        "DEFAULT": ":unpack_refused",
    }),
    visibility = ["PUBLIC"],
)

# Read by tools/bootstrap:pin_check_unit, and by the buildrules.dev site tests.
export_file(
    name = "bootstrap.bzl",
    src = "bootstrap.bzl",
    visibility = ["//tools/bootstrap:", "//ci:", "//site:"],
)

scrub_files()
