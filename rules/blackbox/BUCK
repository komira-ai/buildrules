load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# blackbox (README.md): the runner of a `blackbox_test` (defs.bzl), `blackbox_run`, as one static Zig executable built by the pinned zig behind its unit tests.
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_module", "zig_test")

# Zig 0.15 code (std.Io, ArrayList.empty): it builds with the pinned zig_next, as check, toolbox and the unpack of tools/bootstrap do.
_ZIG = "buildrules//rules/pins:zig_next"
_ZIG_VERSION = "buildrules//rules/pins:zig_next_version"

# The sources of the runner. plat.zig is its real platform (processes, signals, the clock, loopback ports); main.zig only forwards to cli.zig and is
# compiled into no unit test.
_SRCS = [
    "cli.zig",
    "deb.zig",
    "farm.zig",
    "io.zig",
    "plat.zig",
    "probe.zig",
    "run.zig",
]

# The data member of a package is read by the extractor of tools/bootstrap (`unpack`'s), so its checks are the same.
_DEPS = ["//tools/bootstrap:bootstrap_archive"]

# The writer of the tests' packages (debkit.zig), also the toy's packer (toy/).
zig_module(
    name = "debkit",
    src = "debkit.zig",
    visibility = ["//rules/blackbox/..."],
)

# The cases of each part. The cases of plat start programs for real: the toolbox (rules/toolbox) is the program that only has a status (`true`, `false`)
# and the toy (toy/) the one that listens.
_SUPPORT = ["pbkit.zig", "testkit.zig"]
_TESTS = ["cli", "deb", "farm", "plat", "probe", "run", "sweeps"]
_TOOLS = {"TOOLBOX": "buildrules//rules/toolbox:toolbox", "TOY": "//rules/blackbox/toy:toy"}

[
    zig_test(
        name = name + "_unit",
        src = name + "_test.zig",
        imports = _SRCS + _SUPPORT,
        deps = _DEPS + [":debkit"],
        env_tools = _TOOLS,
        zig = _ZIG,
    )
    for name in _TESTS
]

# All the cases in one test program, on which the coverage is measured (a block one part's cases run and another's do not is counted once).
zig_test(
    name = "all_unit",
    src = "all_test.zig",
    imports = _SRCS + _SUPPORT + [name + "_test.zig" for name in _TESTS],
    deps = _DEPS + [":debkit"],
    env_tools = _TOOLS,
    zig = _ZIG,
)

# The executable, built only when the unit tests passed.
zig_exe(
    name = "blackbox_run",
    src = "main.zig",
    imports = _SRCS,
    deps = _DEPS,
    unit_tests = [":" + name + "_unit" for name in _TESTS] + [_ZIG_VERSION],
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The executable as a process (blackbox_exe_test.zig): the toy's package run against the toy's fake and driver by the real platform, passing, and red
# for each way a run fails (a driver that fails, a fake that exits before it is ready, a package that is not the pinned one). A validation of
# `:blackbox_run`; it adds nothing to the coverage.
zig_test(
    name = "blackbox_exe_test",
    src = "blackbox_exe_test.zig",
    deps = [":debkit"],
    env_tools = {"BLACKBOX_RUN": ":blackbox_run", "TOY": "//rules/blackbox/toy:toy", "TOOLBOX": "buildrules//rules/toolbox:toolbox"},
    visibility = ["PUBLIC"],
    zig = _ZIG,
)

# The coverage of the sources the unit tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to.
zig_coverage(
    test_targets = [":all_unit"],
    expect = ["rules/blackbox/" + f for f in _SRCS],
)

scrub_files()
