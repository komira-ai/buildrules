# The comparison of a committed table's graph with what the pinned mopm prints now (`:table`, rules/mojo/check.bzl).
zig_test(
    name = "table_check_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/table_check_test.zig",
    imports = ["tools/table_check.zig"],
