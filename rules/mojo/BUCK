# The committed form of a unit graph (a path dependency by identity only), which `buildrules mojo sync` writes and `:table` compares.
# A module of its own: the command line (cli/) and table_check both import it, and neither is built unless its tests passed.
zig_test(
    name = "graph_norm_unit",
    exec_compatible_with = TOOL_EXEC,
    src = "tools/graph_norm_test.zig",
    imports = ["tools/graph_norm.zig"],
    zig = "buildrules//rules/pins:zig_next",
)

zig_module(
    name = "mojo_graph_norm",
    src = "tools/graph_norm.zig",
    unit_tests = [":graph_norm_unit"],
    visibility = ["PUBLIC"],
)

# The comparison of a committed table's graph with what the pinned mopm prints now (`:table`, rules/mojo/check.bzl).
zig_test(
    name = "table_check_unit",
    exec_compatible_with = TOOL_EXEC,
    src = "tools/table_check_test.zig",
    imports = ["tools/table_check.zig"],
    deps = [":mojo_graph_norm"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

zig_exe(
    name = "table_check",
    exec_compatible_with = TOOL_EXEC,
    src = "tools/table_check.zig",
    deps = [":mojo_graph_norm"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":table_check_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

