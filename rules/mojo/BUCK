# Read by the buildrules.dev site tests (site/BUCK), which check its pages against this file.
export_file(
    name = "defs.bzl",
    src = "defs.bzl",
    visibility = ["//site:"],
)

export_file(
    name = "providers.bzl",
    src = "providers.bzl",
    visibility = ["//site:"],
)

# The coverage of the sources the tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to. mojo_compile.zig and
# conda_unpack.zig have no unit test and are not measured.
zig_coverage(
    test_targets = [":mojo_launch_unit", ":prebuilt_unpack_unit", ":files_check_unit", ":table_check_unit"],
    expect = ["rules/mojo/tools/" + f for f in ["mojo_launch.zig", "prebuilt_unpack.zig", "files_check.zig", "table_check.zig"]],
)

scrub_files()
