load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The Mojo rules (docs/contract.md, section 12): the tools their actions run, built by the pinned zig behind their unit tests.
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("//rules/core:platform.bzl", "TOOL_EXEC", "by_host", "by_os_cpu")
load("//rules/zig:zig.bzl", "zig_exe", "zig_module", "zig_test")

# The tools the unit, test, conda and closure actions run are built for the host that runs them (rules/mojo/exec.bzl): `zig_exe` is a build on the linux x86_64
# worker whatever it targets, so these are cross-compiled by the one pinned zig. They are `exec_dep`s, configured as the execution platform of the rule that runs
# them, so the select is made on the host: linux x86_64 (the default, and the target of every key they had) or the host of a farm's Arm workers.
_HOST_TARGET = by_host("x86_64-linux-musl", "aarch64-linux-musl", "aarch64-macos")

# The compile watchdog's process-tree code and its loop (tools/proc_tree.zig): the /proc parsing, the idle arithmetic and the loop, which the tests
# drive on a manual clock.
zig_test(
    name = "proc_tree_unit",
    exec_compatible_with = TOOL_EXEC,
    src = "tools/proc_tree.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

# The compile wrapper (tools/*.zig). It is the one place
# that knows how to run the hermetic compiler; mopm executes it through mojo_launch.
zig_exe(
    name = "mojo_compile",
    target = _HOST_TARGET,
    exec_compatible_with = TOOL_EXEC,
    src = "tools/mojo_compile.zig",
    imports = [
        "tools/cc_shim.zig",
        "tools/compile_args.zig",
        "tools/modular_cfg.zig",
        "tools/proc_tree.zig",
    ],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":proc_tree_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

# The same wrapper for macOS arm64 (tools/mojo_compile_macos.zig, the macOS main over the modules of the Linux one), built on a Linux worker for the macOS
# triple: the `wrapper` of a unit that runs on a macOS worker (rules/mojo/unit.bzl). tools/mojo_compile.zig is the Linux wrapper and refuses to be built for
# another operating system. The unit tests run on Linux (the pure modules, the libproc layouts); the compile itself runs on the macOS workers.
_MOJO_COMPILE_MACOS_SRCS = [
    "tools/cc_shim.zig",
    "tools/compile_args.zig",
    "tools/host_identity.zig",
    "tools/modular_cfg.zig",
    "tools/mojo_compile.zig",
    "tools/proc_tree.zig",
    "tools/proc_tree_macos.zig",
]

zig_test(
    name = "mojo_compile_macos_unit",
    exec_compatible_with = TOOL_EXEC,
    imports = _MOJO_COMPILE_MACOS_SRCS,
    src = "tools/mojo_compile_macos.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

zig_exe(
    name = "mojo_compile_macos",
    target = "aarch64-macos",
    exec_compatible_with = TOOL_EXEC,
    imports = _MOJO_COMPILE_MACOS_SRCS,
    src = "tools/mojo_compile_macos.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":mojo_compile_macos_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

# The wrapper of the host that runs the compile: what a unit is given as `wrapper`.
alias(
    name = "mojo_compile_host",
    actual = by_os_cpu({
        "macos_aarch64": ":mojo_compile_macos",
        "DEFAULT": ":mojo_compile",
    }),
    visibility = ["PUBLIC"],
)

# `conda_unpack --all-libs`: every shared library of a package's lib/ (conda_libs.zig), behind its unit tests. The rest of conda_unpack (the compiler closure) has no unit test.
zig_test(
    name = "conda_libs_unit",
    exec_compatible_with = TOOL_EXEC,
    src = "tools/conda_libs_test.zig",
    imports = ["tools/conda_libs.zig", "tools/prebuilt_unpack.zig"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

# conda_unpack (a newer copy than rules/zig's: zstd windows, CLOSURE_MANIFEST): unpacks the compiler closure.
zig_exe(
    name = "conda_unpack",
    target = _HOST_TARGET,
    exec_compatible_with = TOOL_EXEC,
    src = "tools/conda_unpack.zig",
    imports = ["tools/conda_libs.zig", "tools/prebuilt_unpack.zig"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":conda_libs_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

# `<toolchain>/mojo_compile`, which mopm executes: puts the wrapper's options (where the compiler and the zig are) in front
