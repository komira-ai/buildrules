load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# mopm-toolchain.toml is required (docs/contract.md, section 12): the refusals of rules/mojo/defs.bzl as analysis tests (rules/rust/refusal.bzl).
# Each target is green only if the rule refused as stated; make the rule fall back to a default and it stops existing (analysis fails).
load("//rules/mojo:defs.bzl", "check_toolchain_file_present", "check_toolchain_file_recorded", "graph_path_in_package", "member_label", "native_wiring")
load("//rules/mojo:unit.bzl", "check_closure_ids", "cov_link_natives")
load("//rules/rust:refusal.bzl", "accepts", "recording", "refusal_test", "refuses")
load(":natives.bzl", "BUILT", "BUILT_UNIT", "PREBUILT", "UNIT", "USER", "built_natives_are_the_targets_of_their_units", "native_units_are_told_by_their_id", "own_natives", "reversed_graph_is_reversed", "wiring_is_as_the_graph_says")
load(":siblings.bzl", "graph_paths_below_the_package", "nested_member_keeps_its_target", "sibling_is_named_by_its_directory", "sibling_with_a_path_up_is_named_by_its_directory", "workspace_is_flat_at_repository_paths")
load("//rules/mojo:sync.bzl", "sync_packages", "sync_stage_tree")
load(":sync.bzl", "packages_are_normalized", "stage_holds_the_workspaces_and_the_other_files_once")
load(":test_data_targets.bzl", "test_data_targets")

_NAMED = ["mopm-toolchain.toml", "is required", "no default", "[toolchain]", "mopm = \"0.0.42\"", "mojo = \"1.0.0\""]

# A table whose recorded files do not include the toolchain file (made by hand, or before the file was required): refused.
_r1, _f1 = recording()
check_toolchain_file_recorded({"MANIFEST_SHA256": {"mopm.toml": "00", "mopm.lock": "11"}}, _f1)
refusal_test(name = "table_without_toolchain_file_is_refused", refusals = _r1, contains = _NAMED + ["buildrules mojo sync"], visibility = ["PUBLIC"])

# A table with no MANIFEST_SHA256 at all: refused.
_r2, _f2 = recording()
check_toolchain_file_recorded({}, _f2)
refusal_test(name = "table_without_manifest_is_refused", refusals = _r2, contains = _NAMED, visibility = ["PUBLIC"])

# The file is recorded (here or above): accepted.
_r3, _f3 = recording()
check_toolchain_file_recorded({"MANIFEST_SHA256": {"mopm.toml": "00", "../../mopm-toolchain.toml": "22"}}, _f3)
refusal_test(name = "recorded_toolchain_file_is_accepted", refusals = _r3, none = True, visibility = ["PUBLIC"])

# The checkout has no such file (the glob of the BUCK file is empty): refused, naming the package.
_r4, _f4 = recording()
check_toolchain_file_present("examples/x", [], _f4)
refusal_test(name = "missing_toolchain_file_is_refused", refusals = _r4, contains = _NAMED + ["examples/x"], visibility = ["PUBLIC"])

_r5, _f5 = recording()
check_toolchain_file_present("examples/x", ["mopm-toolchain.toml"], _f5)
refusal_test(name = "present_toolchain_file_is_accepted", refusals = _r5, none = True, visibility = ["PUBLIC"])

# Where the native libraries of a unit come from (rules/mojo/tests/natives.bzl has the unit and the checks).
_r6, _f6 = recording()
wiring_is_as_the_graph_says(_f6)
refusal_test(name = "native_order_and_targets_come_from_the_graph", refusals = _r6, none = True, visibility = ["PUBLIC"])

_r7, _f7 = recording()
reversed_graph_is_reversed(_f7)
refusal_test(name = "native_order_is_not_sorted", refusals = _r7, none = True, visibility = ["PUBLIC"])

_r8, _f8 = recording()
own_natives(_f8)
refusal_test(name = "prebuilt_unit_extracts_its_own_static_natives", refusals = _r8, none = True, visibility = ["PUBLIC"])

# Natives a member builds (rules/mojo/tests/natives.bzl has the unit): a `built` entry is the target of the native unit it names.
_r9, _f9 = recording()
built_natives_are_the_targets_of_their_units(_f9)
refusal_test(name = "built_native_is_the_target_of_its_unit", refusals = _r9, none = True, visibility = ["PUBLIC"])

_r10, _f10 = recording()
native_units_are_told_by_their_id(_f10)
refusal_test(name = "native_units_are_told_by_their_id", refusals = _r10, none = True, visibility = ["PUBLIC"])

# An entry built by a native unit the graph does not have: refused, with the unit, the library and the missing unit.
refuses(
    name = "built_native_without_a_unit_is_refused",
    check = native_wiring,
    args = [BUILT_UNIT, {"base_sys": True}, {}, "examples/x"],
    kwargs = {"built": {"native:core/core": "//core:native_core"}},
    contains = ["examples/x", "app@1.0.0#mojo1.0.0/test:t links the native library libshim.a", "built by native:app/shim", "no such native unit"],
)

# A library a member builds that the user also names: two sources for one file.
refuses(
    name = "built_native_named_twice_is_refused",
    check = native_wiring,
    args = [BUILT_UNIT, {"base_sys": True}, {"libcore.a": "//x:mine"}, "examples/x"],
    kwargs = {"built": BUILT},
    contains = ["libcore.a is built by the member core (native:core/core)", "remove it"],
)

# A native the lock does not provide and the user did not name: refused, with the unit and the soname.
refuses(
    name = "native_without_a_source_is_refused",
    check = native_wiring,
    args = [UNIT, PREBUILT, {}, "examples/x"],
    contains = ["examples/x", "links the native library libcnative.so.1", "natives = {...}"],
)

# A static library of a workspace member (its package is not a prebuilt unit of the graph) is the user's to supply.
refuses(
    name = "static_native_of_a_member_without_a_source_is_refused",
    check = native_wiring,
    args = [UNIT, {"base_sys": True, "cnative": True}, USER, "examples/x"],
    contains = ["links the native library libprobe_sys.a"],
)

accepts(
    name = "static_native_of_a_member_the_user_supplies_is_accepted",
    check = native_wiring,
    args = [UNIT, {"base_sys": True, "cnative": True}, dict(USER, **{"libprobe_sys.a": "//x:probe"}), "examples/x"],
)

# Two sources for one file: the lock's registry package and the user's entry.
refuses(
    name = "native_named_twice_is_refused",
    check = native_wiring,
    args = [UNIT, PREBUILT, dict(USER, **{"libbase_sys.a": "//x:mine"}), "examples/x"],
    contains = ["libbase_sys.a comes from the lock", "registry package base_sys", "remove it"],
)

# The native libraries of the instrumented link of a test's branch coverage (rules/mojo/unit.bzl, `cov_link_natives`): the unit's libraries, no
# other, in the graph's order. Two static archives, the first needing the second (the graph lists a library before every library it needs), and a
# shared object.
_INSTRUMENTED = ["libprobe_sys.a", "libbase_sys.a", "libcnative.so.1"]
_ALL = {"libprobe_sys.a": "//x:probe", "libbase_sys.a": "//x:base", "libcnative.so.1": "//x:cnative"}
_NEEDS = {"libprobe_sys.a": ["libbase_sys.a"]}

accepts(
    name = "instrumented_link_with_the_units_natives_in_its_order_is_accepted",
    check = cov_link_natives,
    args = ["//x:test__pgo", _INSTRUMENTED, _ALL, _NEEDS],
)

# A library the unit links and the instrumented link is not given: the test cannot link, so it is refused at analysis, naming the library.
refuses(
    name = "instrumented_link_without_one_of_the_natives_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", _INSTRUMENTED, {"libprobe_sys.a": "//x:probe", "libcnative.so.1": "//x:cnative"}, _NEEDS],
    contains = ["//x:test__pgo", "the unit links the native library libbase_sys.a", "instrumented link", "add it to `natives`"],
)

# A library the unit does not link: refused, so the instrumented binary is not linked with code the test is not.
refuses(
    name = "instrumented_link_with_a_native_the_unit_does_not_link_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", _INSTRUMENTED, dict(_ALL, **{"libother.a": "//x:other"}), _NEEDS],
    contains = ["`natives` gives the instrumented link libother.a", "which the unit does not link"],
)

# An archive listed before the one it is needed by: the other order of the ordinary link, where the linker would leave symbols undefined.
refuses(
    name = "instrumented_link_with_a_needed_archive_first_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", ["libbase_sys.a", "libprobe_sys.a", "libcnative.so.1"], _ALL, _NEEDS],
    contains = ["libbase_sys.a is linked before libprobe_sys.a, which needs it", "a static archive comes before every archive it needs"],
)

# A need the unit's link does not carry at all.
refuses(
    name = "instrumented_link_with_a_need_the_unit_does_not_link_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", ["libprobe_sys.a"], {"libprobe_sys.a": "//x:probe"}, _NEEDS],
    contains = ["libprobe_sys.a needs libbase_sys.a, which the unit's link does not carry"],
)

