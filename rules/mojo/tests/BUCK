)

# The native libraries of the instrumented link of a test's branch coverage (rules/mojo/unit.bzl, `cov_link_natives`): the unit's libraries, no
# other, in the graph's order. Two static archives, the first needing the second (the graph lists a library before every library it needs), and a
# shared object.
_INSTRUMENTED = ["libprobe_sys.a", "libbase_sys.a", "libcnative.so.1"]
_ALL = {"libprobe_sys.a": "//x:probe", "libbase_sys.a": "//x:base", "libcnative.so.1": "//x:cnative"}
_NEEDS = {"libprobe_sys.a": ["libbase_sys.a"]}

accepts(
    name = "instrumented_link_with_the_units_natives_in_its_order_is_accepted",
    check = cov_link_natives,
    args = ["//x:test__pgo", _INSTRUMENTED, _ALL, _NEEDS],
)

# A library the unit links and the instrumented link is not given: the test cannot link, so it is refused at analysis, naming the library.
refuses(
    name = "instrumented_link_without_one_of_the_natives_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", _INSTRUMENTED, {"libprobe_sys.a": "//x:probe", "libcnative.so.1": "//x:cnative"}, _NEEDS],
    contains = ["//x:test__pgo", "the unit links the native library libbase_sys.a", "instrumented link", "add it to `natives`"],
)

# A library the unit does not link: refused, so the instrumented binary is not linked with code the test is not.
refuses(
    name = "instrumented_link_with_a_native_the_unit_does_not_link_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", _INSTRUMENTED, dict(_ALL, **{"libother.a": "//x:other"}), _NEEDS],
    contains = ["`natives` gives the instrumented link libother.a", "which the unit does not link"],
)

# An archive listed before the one it is needed by: the other order of the ordinary link, where the linker would leave symbols undefined.
refuses(
    name = "instrumented_link_with_a_needed_archive_first_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", ["libbase_sys.a", "libprobe_sys.a", "libcnative.so.1"], _ALL, _NEEDS],
    contains = ["libbase_sys.a is linked before libprobe_sys.a, which needs it", "a static archive comes before every archive it needs"],
)

# A need the unit's link does not carry at all.
refuses(
    name = "instrumented_link_with_a_need_the_unit_does_not_link_is_refused",
    check = cov_link_natives,
    args = ["//x:test__pgo", ["libprobe_sys.a"], {"libprobe_sys.a": "//x:probe"}, _NEEDS],
    contains = ["libprobe_sys.a needs libbase_sys.a, which the unit's link does not carry"],
)

