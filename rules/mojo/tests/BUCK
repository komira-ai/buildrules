# An entry built by a native unit the graph does not have: refused, with the unit, the library and the missing unit.
refuses(
    name = "built_native_without_a_unit_is_refused",
    check = native_wiring,
    args = [BUILT_UNIT, {"base_sys": True}, {}, "examples/x"],
    kwargs = {"built": {"native:core/core": "//core:native_core"}},
    contains = ["examples/x", "app@1.0.0#mojo1.0.0/test:t links the native library libshim.a", "built by native:app/shim", "no such native unit"],
)

# A library a member builds that the user also names: two sources for one file.
