load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# mopm-toolchain.toml is required (docs/contract.md, section 12): the refusals of rules/mojo/defs.bzl as analysis tests (rules/rust/refusal.bzl).
# Each target is green only if the rule refused as stated; make the rule fall back to a default and it stops existing (analysis fails).
load("//rules/mojo:defs.bzl", "check_toolchain_file_present", "check_toolchain_file_recorded", "graph_path_in_package", "member_label", "native_wiring")
load("//rules/mojo:unit.bzl", "check_closure_ids")
load("//rules/rust:refusal.bzl", "accepts", "recording", "refusal_test", "refuses")
load(":natives.bzl", "PREBUILT", "UNIT", "USER", "own_natives", "reversed_graph_is_reversed", "wiring_is_as_the_graph_says")
load(":siblings.bzl", "graph_paths_below_the_package", "nested_member_keeps_its_target", "sibling_is_named_by_its_directory", "sibling_with_a_path_up_is_named_by_its_directory", "workspace_is_flat_at_repository_paths")

_NAMED = ["mopm-toolchain.toml", "is required", "no default", "[toolchain]", "mopm = \"0.0.20\"", "mojo = \"1.0.0\""]

# A table whose recorded files do not include the toolchain file (made by hand, or before the file was required): refused.
_r1, _f1 = recording()
check_toolchain_file_recorded({"MANIFEST_SHA256": {"mopm.toml": "00", "mopm.lock": "11"}}, _f1)
refusal_test(name = "table_without_toolchain_file_is_refused", refusals = _r1, contains = _NAMED + ["buildrules mojo sync"], visibility = ["PUBLIC"])

# A table with no MANIFEST_SHA256 at all: refused.
_r2, _f2 = recording()
check_toolchain_file_recorded({}, _f2)
refusal_test(name = "table_without_manifest_is_refused", refusals = _r2, contains = _NAMED, visibility = ["PUBLIC"])

# The file is recorded (here or above): accepted.
_r3, _f3 = recording()
check_toolchain_file_recorded({"MANIFEST_SHA256": {"mopm.toml": "00", "../../mopm-toolchain.toml": "22"}}, _f3)
refusal_test(name = "recorded_toolchain_file_is_accepted", refusals = _r3, none = True, visibility = ["PUBLIC"])

# The checkout has no such file (the glob of the BUCK file is empty): refused, naming the package.
_r4, _f4 = recording()
check_toolchain_file_present("examples/x", [], _f4)
refusal_test(name = "missing_toolchain_file_is_refused", refusals = _r4, contains = _NAMED + ["examples/x"], visibility = ["PUBLIC"])

_r5, _f5 = recording()
check_toolchain_file_present("examples/x", ["mopm-toolchain.toml"], _f5)
refusal_test(name = "present_toolchain_file_is_accepted", refusals = _r5, none = True, visibility = ["PUBLIC"])

# Where the native libraries of a unit come from (rules/mojo/tests/natives.bzl has the unit and the checks).
_r6, _f6 = recording()
wiring_is_as_the_graph_says(_f6)
refusal_test(name = "native_order_and_targets_come_from_the_graph", refusals = _r6, none = True, visibility = ["PUBLIC"])

_r7, _f7 = recording()
reversed_graph_is_reversed(_f7)
refusal_test(name = "native_order_is_not_sorted", refusals = _r7, none = True, visibility = ["PUBLIC"])

_r8, _f8 = recording()
own_natives(_f8)
refusal_test(name = "prebuilt_unit_extracts_its_own_static_natives", refusals = _r8, none = True, visibility = ["PUBLIC"])

# A native the lock does not provide and the user did not name: refused, with the unit and the soname.
refuses(
    name = "native_without_a_source_is_refused",
    check = native_wiring,
    args = [UNIT, PREBUILT, {}, "examples/x"],
    contains = ["examples/x", "links the native library libcnative.so.1", "natives = {...}"],
)

# A static library of a workspace member (its package is not a prebuilt unit of the graph) is the user's to supply.
refuses(
    name = "static_native_of_a_member_without_a_source_is_refused",
    check = native_wiring,
    args = [UNIT, {"base_sys": True, "cnative": True}, USER, "examples/x"],
    contains = ["links the native library libprobe_sys.a"],
)

accepts(
    name = "static_native_of_a_member_the_user_supplies_is_accepted",
    check = native_wiring,
    args = [UNIT, {"base_sys": True, "cnative": True}, dict(USER, **{"libprobe_sys.a": "//x:probe"}), "examples/x"],
)

# Two sources for one file: the lock's registry package and the user's entry.
refuses(
    name = "native_named_twice_is_refused",
    check = native_wiring,
    args = [UNIT, PREBUILT, dict(USER, **{"libbase_sys.a": "//x:mine"}), "examples/x"],
    contains = ["libbase_sys.a comes from the lock", "registry package base_sys", "remove it"],
)

# Path dependencies that are siblings of the package (rules/mojo/tests/siblings.bzl has the checks).
_r9, _f9 = recording()
nested_member_keeps_its_target(_f9)
refusal_test(name = "member_below_the_package_keeps_its_target", refusals = _r9, none = True, visibility = ["PUBLIC"])

_r10, _f10 = recording()
sibling_is_named_by_its_directory(_f10)
refusal_test(name = "sibling_library_is_named_by_its_directory", refusals = _r10, none = True, visibility = ["PUBLIC"])

_r11, _f11 = recording()
sibling_with_a_path_up_is_named_by_its_directory(_f11)
refusal_test(name = "sibling_written_with_a_path_up_is_named_by_its_directory", refusals = _r11, none = True, visibility = ["PUBLIC"])

_r12, _f12 = recording()
workspace_is_flat_at_repository_paths(_f12)
refusal_test(name = "workspace_holds_every_file_at_its_repository_path", refusals = _r12, none = True, visibility = ["PUBLIC"])

_r13, _f13 = recording()
graph_paths_below_the_package(_f13)
refusal_test(name = "graph_paths_are_read_from_the_base_the_table_says", refusals = _r13, none = True, visibility = ["PUBLIC"])

# A path dependency outside the repository root has no target: refused, naming it and the root.
refuses(
    name = "member_outside_the_root_is_refused",
    check = member_label,
    args = ["src/codec", "json@1.0.0#mojo1.0.0/lib", "json", "../elsewhere/src/json", ""],
    contains = ["json@1.0.0#mojo1.0.0/lib", "../elsewhere/src/json", "outside the repository root"],
)

# The same when the graph's paths start at the package and the way up leaves the root.
refuses(
    name = "member_above_the_root_from_the_package_is_refused",
    check = member_label,
    args = ["codec", "json@1.0.0#mojo1.0.0/lib", "json", "../../json/src/json", "codec"],
    contains = ["outside the repository root"],
)

refuses(
    name = "member_with_an_absolute_root_is_refused",
    check = member_label,
    args = ["src/codec", "json@1.0.0#mojo1.0.0/lib", "json", "/opt/json/src/json", ""],
    contains = ["outside the repository root"],
)

# A library that is not at <dir>/src/<package> is not a package's library.
refuses(
    name = "member_not_at_src_name_is_refused",
    check = member_label,
    args = ["src/codec", "json@1.0.0#mojo1.0.0/lib", "json", "lib/json", ""],
    contains = ["not <dir>/src/json", "lib/json"],
)

refuses(
    name = "graph_path_outside_the_package_is_refused",
    check = graph_path_in_package,
    args = ["src/other/x.mojo", "src/codec", True],
    contains = ["src/other/x.mojo", "not below the package's directory"],
)

# A library built from another version of its package, or for another Mojo, than the graph names is refused, naming both.
refuses(
    name = "dependency_of_another_version_is_refused",
    check = check_closure_ids,
    args = ["//x:t", {"util": "util@0.1.0#mojo1.0.0/lib", "base": "base@0.1.0#mojo1.0.0/lib"}, {"util": "util@0.2.0#mojo1.0.0/lib", "base": "base@0.1.0#mojo1.0.0/lib"}],
    contains = ["//x:t", "util@0.1.0#mojo1.0.0/lib", "util@0.2.0#mojo1.0.0/lib", "another version"],
)

refuses(
    name = "dependency_built_for_another_mojo_is_refused",
    check = check_closure_ids,
    args = ["//x:t", {"util": "util@0.1.0#mojo1.0.0/lib"}, {"util": "util@0.1.0#mojo1.1.0/lib"}],
    contains = ["util@0.1.0#mojo1.0.0/lib", "util@0.1.0#mojo1.1.0/lib", "another Mojo"],
)

accepts(
    name = "dependencies_built_as_the_graph_says_are_accepted",
    check = check_closure_ids,
    args = ["//x:t", {"util": "util@0.1.0#mojo1.0.0/lib", "base": "base@0.1.0#mojo1.0.0/lib"}, {"base": "base@0.1.0#mojo1.0.0/lib", "util": "util@0.1.0#mojo1.0.0/lib"}],
)

scrub_files()
