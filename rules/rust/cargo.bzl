"""The front door: `cargo_workspace` and `cargo_package`.

A repository that already builds with cargo gets Buck2 targets from cargo's own files and one generated table, with no
hand-written rules:

    # BUCK                           (the workspace root package)
    load("//:buildrules.bzl", "cargo_workspace")   # generated by `buildrules sync`: binds the table to the macros
    cargo_workspace(path = ".")

    # crates/my-lib/BUCK             (one per member; `buildrules cargo adopt` writes it)
    load("//:buildrules.bzl", "cargo_package")
    cargo_package(path = ".")

    # which is, unbound (what buildrules.bzl calls):  cargo_package(path = ".", table = CARGO, third_party = THIRD_PARTY)

Starlark cannot read TOML and a `load` cannot name a computed path, so the table is passed in as a value. Nothing here parses a
manifest: lints, policy, features, profiles and dependency edges were baked into the table by `buildrules sync`.

Targets of a member package (all always present; `coverage` refuses until P8):

    :lib       the library units (debug profile)                :bin       the binaries (only if the member has some)
    :debug     lib + bins, as `cargo build -p`                  :release   the same under `--release`
    :test      every cargo test target: the lib test binary, each tests/*.rs, each bin test; one `.passed` marker each
               Each is also a `buck2 test` target (label `test`): the same pinned binary, environment and working directory.
    :lint      clippy over every unit `cargo clippy -p --all-targets` checks, `[lints]` as flags, `clippy.toml` as an input
    :coverage  refuses with the reason (P8)
    :<action>  one per action named in [workspace.metadata.buildrules] / [package.metadata.buildrules]: its steps, chained

Actions (policy only, resolved at sync):  `actions = { ci = ["lint", "test"] }`; an action may not take a step's name.
Doctests are out of v0: `:test` runs what `cargo test` runs minus them (a recorded gap).

A stale table is red: every `:test`, `:lint`, `:debug` and `:release` carries the workspace's `:check` as a validation, which compares
the sha256 of Cargo.lock, rust-toolchain.toml and every Cargo.toml with what the table was made from. The compile actions
never take a Cargo.toml as an input, so editing policy or metadata re-runs the check and nothing else.
"""

load(":cargo_unit.bzl", "cargo_unit", "unit_group")
load(":pins.bzl", "RUST_VERSIONS")

_STEPS = ["lint", "debug", "test", "release", "coverage"]

def _tname(uid):
    return uid.replace(":", "_")

def _strip_of(p):
    s = p["strip"]
    if s in (None, "none", "None"):
        return None
    if type(s) == "dict":
        if "deferred" in s:
            return None
        r = s.get("resolved")
        if r == "None":
            return None
        if type(r) == "dict" and "Named" in r:
            return r["Named"]
        if type(r) == "str":
            return r.lower()
    fail("unrecognized strip value {}".format(s))

def _join(a, b):
    if not a or a == ".":
        return b
    if not b or b == ".":
        return a
    return a + "/" + b

def _member_of(table, path):
    """The PACKAGES row whose directory is `path` under the workspace, and the workspace's package (cell-relative)."""
    here = native.package_name()
    d = here
    for part in path.split("/"):
        if part in ("", "."):
            continue
        if part == "..":
            d = d.rsplit("/", 1)[0] if "/" in d else ""
        else:
            d = _join(d, part)
    for name, row in table["PACKAGES"].items():
        if d == row["path"] or d.endswith("/" + row["path"]):
            ws = d[:len(d) - len(row["path"])].rstrip("/")
            return name, row, ws
    fail("cargo_package: {} is not a member in the table (known: {}); run `buildrules sync`".format(d, ", ".join(table["PACKAGES"])))

def _label(did, units, ws, third_party, here):
    d = units[did]
    if d["source"] == "registry":
        return third_party + ":" + _tname(did)
    pkg = _join(ws, d["path"])
    return (":" if pkg == here else "//" + pkg + ":") + _tname(did)

def _deps_of(u, units, ws, third_party, here):
    """extern name -> label. A binary of the package is keyed `bin:<name>` (it becomes CARGO_BIN_EXE_<name>, not `--extern`)."""
    deps = {}
    for ext, did in u["deps"]:
        d = units[did]
        key = ("bin:" + d["target_name"]) if d["target_kind"] == ["bin"] and d["mode"] == "build" else ext
        if key in deps:
            fail("{}: two dependencies named {}".format(u["crate"], key))
        deps[key] = _label(did, units, ws, third_party, here)
    return deps

def _unit_args(uid, u, row, kind_globs):
    p = u["profile"]
    if str(p["lto"]) != "false":
        fail("{}: lto={} is not in v0".format(uid, p["lto"]))
    if p["codegen_backend"] != None:
        fail("{}: codegen_backend {}".format(uid, p["codegen_backend"]))
    if p["rpath"] or p["incremental"] or p.get("split_debuginfo"):
        fail("{}: rpath/incremental/split_debuginfo not supported".format(uid))
    custom = u["target_kind"] == ["custom-build"]
    cts = u["crate_types"]
    ct = "rlib" if ("rlib" in cts or "lib" in cts) else cts[0]
    ctype = {"lib": "rlib", "rlib": "rlib", "proc-macro": "proc-macro", "bin": "bin"}.get(ct)
    if ctype == None:
        fail("{}: crate type {} not in v0".format(uid, ct))
    kw = dict(
        pkg = u["crate"],
        version = u["version"],
        crate_name = u["crate"].replace("-", "_") if custom else u["target_name"].replace("-", "_"),
        mode = u["mode"],
        crate_type = ctype,
        side = u["side"],
        edition = u["edition"],
        root = u["crate_root"],
        crate_hash = uid.split(":")[1],
        target_kind = u["target_kind"][0],
        target_name = u["target_name"],
        opt_level = str(p["opt_level"]),
        debuginfo = str(p["debuginfo"]),
        debug_assertions = p["debug_assertions"],
        overflow_checks = p["overflow_checks"],
        rustc_flags = list(row["check_cfg"]) + list(row["lints"]["rust"]),
        visibility = ["PUBLIC"],
    )
    if custom:
        kw["build_script_name"] = u["target_name"].replace("-", "_")
    if p["panic"] != "unwind":
        kw["panic"] = p["panic"]
    if _strip_of(p):
        kw["strip"] = _strip_of(p)
    if p["codegen_units"] != None:
        kw["codegen_units"] = str(p["codegen_units"])
    if u["cfgs"]:
        kw["cfgs"] = list(u["cfgs"])
    kw["srcs"] = native.glob(kind_globs)
    return kw

def _globs_for(u):
    kind = u["target_kind"][0]
    g = {"test": ["tests/**"], "custom-build": ["build.rs"]}.get(kind, ["src/**"])
    if kind == "lib":
        g = g + ["build.rs"]
    # A [[bin]] or [[test]] whose `path` is outside src/ and tests/ (tools/lambda/canary/main.rs): its directory is a source too.
    rootdir = u["crate_root"].rsplit("/", 1)[0] if "/" in u["crate_root"] else ""
    if kind != "custom-build" and rootdir and not (rootdir == "src" or rootdir.startswith("src/") or rootdir == "tests" or rootdir.startswith("tests/")):
        g = g + [rootdir.split("/")[0] + "/**"]
    return g

def _outside_globs(mine):
    """Globs of the directories that hold the roots of this package's targets outside src/ and tests/."""
    out = []
    for u in mine.values():
        for g in _globs_for(u):
            if not (g.startswith("src/") or g.startswith("tests/") or g == "build.rs") and g not in out:
                out.append(g)
    return out

# ---- steps -----------------------------------------------------------------------

def _step_impl(ctx):
    outs = []
    for d in ctx.attrs.deps:
        outs += d[DefaultInfo].default_outputs
    info = [DefaultInfo(default_outputs = outs)]
    if ctx.attrs.check:
        info.append(ValidationInfo(validations = [
            ValidationSpec(name = "cargo_table_in_sync", validation_result = ctx.attrs.check[DefaultInfo].default_outputs[0]),
        ]))
    return info

_step = rule(
    impl = _step_impl,
    attrs = {
        "check": attrs.option(attrs.dep(), default = None),
        "deps": attrs.list(attrs.dep()),
    },
)

def _refuse_impl(ctx):
    fail("{}: {}".format(ctx.label, ctx.attrs.why))

# A target that is not implemented fails when it is built by name. It also requires a constraint no platform has, so a
# wildcard (`buck2 build //...`) skips it as incompatible instead of failing the whole build.
_refuse = rule(impl = _refuse_impl, attrs = {"why": attrs.string()})

def _closure_ids(roots, units):
    seen = {}
    todo = list(roots)
    for _ in range(100000):
        if not todo:
            break
        k = todo.pop()
        if k in seen:
            continue
        seen[k] = True
        for _ext, d in units[k]["deps"]:
            todo.append(d)
    return seen

def check_toolchain(table, refuse = fail):
    """The table's Rust version, refused unless buildrules knows how to fetch it, with the hashes the table recorded.

    `refuse` is called with the reason; the default, `fail`, stops the load. A test passes a recorder (rules/rust/refusal.bzl) to see
    the refusal without losing the load. Returns the version, or None after a refusal that did not stop.
    """
    v = table["RUSTC"]
    rec = table.get("TOOLCHAIN")
    if v in RUST_VERSIONS:
        row = RUST_VERSIONS[v]
        if rec != None:
            want = {k: row[k]["sha256"] for k in ["rustc", "rust_std", "cargo", "clippy"]}
            if rec["origin"] != "builtin" or rec["sha256"] != want:
                refuse("the table recorded other hashes for rustc {} than rules/rust/pins.bzl pins ({}): run `buildrules sync`".format(v, rec["origin"]))
                return None
        return v
    if rec == None or rec["origin"] != "buildrules-pins.toml":
        refuse(("the table was generated for rustc {} which buildrules does not pin (it pins {}). Pin your own hashes for it " +
                "in buildrules-pins.toml (docs/contract.md, section 6) and run `buildrules sync`, or change rust-toolchain.toml.").format(v, ", ".join(RUST_VERSIONS)))
        return None
    return v

def cargo_package(path = ".", table = None, third_party = None, check = None, extra_srcs = [], refuse = fail):
    """Declares the targets of one cargo package (see the module comment).

    Args:
        path: the member directory, relative to the BUCK file calling this (`.` in the member's own package).
        table: the generated table as a dict (`UNITS`, `MEMBERS`, `PACKAGES`, `WORKSPACE`, `RUSTC`, ...).
        third_party: the package holding the registry units, e.g. `//third_party/buildrules`.
        check: the workspace's `:check` target (a label string) carried as a validation; default `//<workspace package>:check`.
        extra_srcs: files or directories of the source tree outside this package that the sources read at compile time
            (`include_str!("../../../api/golden.json")`), as labels (`//service/api:golden.json`, `//:tests/corpus`): inputs of
            every unit of the package, and of its test runs. Cargo needs them at those same paths, so a build that works
            under cargo works here.
        refuse: what a refused table calls with the reason; `fail` (the default) stops the load. Only the tests of the refusal
            pass anything else (rules/rust/refusal.bzl): a package that was refused declares nothing.
    """
    if table == None or third_party == None:
        fail("cargo_package: `table` and `third_party` are required (they are written by the generator)")
    rustc = check_toolchain(table, refuse)
    if rustc == None:
        return
    name, row, ws = _member_of(table, path)
    units = table["UNITS"]
    here = native.package_name()
    mine = {k: u for k, u in units.items() if u["source"] == "path" and u["crate"] == name and u["mode"] != "doctest"}
    wsrow = table["WORKSPACE"]
    conf = None
    if wsrow["clippy_conf"]:
        conf = "//" + ws + ":clippy.toml"
    chk = check or ("//" + _join(ws, "") + ":check" if ws else "//:check")

    native.export_file(name = "Cargo.toml", src = "Cargo.toml", visibility = ["PUBLIC"])

    # The package's own files, for whoever needs the tree (`cargo_sync` stages the workspace from these: a glob cannot cross into a member's package).
    native.filegroup(name = "sources", srcs = native.glob(["**"], exclude = ["target/**", "BUCK"]) + ["BUCK"], visibility = ["PUBLIC"])

    m = table["MEMBERS"][name]

    # 1. the member's units, one cargo_unit each (named by content id, as in third_party)
    for uid in sorted(mine):
        u = mine[uid]
        kw = _unit_args(uid, u, row, _globs_for(u))
        if extra_srcs:
            kw["extra_srcs"] = list(extra_srcs)
        if u["mode"] == "test":
            kw["run_data"] = native.glob(["src/**", "tests/**", "build.rs"] + _outside_globs(mine))
        deps = _deps_of(u, units, ws, third_party, here)
        if deps:
            kw["deps"] = deps
        kw["rustc"] = rustc
        cargo_unit(name = _tname(uid), **kw)

    def t(uid):
        return ":" + _tname(uid)

    # 2. steps
    build = m["build"]["roots"]
    test_roots = m["test"]["roots"]
    release = m["release"]["roots"]
    libs = [r for r in build if "lib" in units[r]["target_kind"] or "proc-macro" in units[r]["target_kind"]]
    bins = [r for r in build if "bin" in units[r]["target_kind"]]
    tests = [r for r in test_roots if units[r]["mode"] == "test"]

    _step(name = "lib", deps = [t(r) for r in libs], check = chk, visibility = ["PUBLIC"])
    if bins:
        _step(name = "bin", deps = [t(r) for r in bins], check = chk, visibility = ["PUBLIC"])
    _step(name = "debug", deps = [t(r) for r in build], check = chk, visibility = ["PUBLIC"])
    _step(name = "release", deps = [t(r) for r in release], check = chk, visibility = ["PUBLIC"])
    _step(name = "test", deps = [t(r) for r in tests], check = chk, visibility = ["PUBLIC"])

    # 3. lint: every unit of this package that `cargo clippy -p <pkg> --all-targets` checks (lib, bins, test targets), not build scripts
    reach = _closure_ids(build + test_roots, units)
    lint_ids = sorted([k for k in reach if k in mine and mine[k]["target_kind"] != ["custom-build"] and mine[k]["mode"] in ("build", "test")])
    for uid in lint_ids:
        u = mine[uid]
        kw = _unit_args(uid, u, row, _globs_for(u))
        if extra_srcs:
            kw["extra_srcs"] = list(extra_srcs)
        kw["mode"] = "lint"
        kw["unit_mode"] = u["mode"]
        kw["lint_flags"] = list(row["lints"]["clippy"])
        kw["deny_warnings"] = row["deny_warnings"]
        if conf:
            kw["conf_dir"] = conf
        deps = _deps_of(u, units, ws, third_party, here)
        if deps:
            kw["deps"] = deps
        kw["rustc"] = rustc
        cargo_unit(name = _tname(uid) + "_lint", **kw)
    _step(name = "lint", deps = [t(r) + "_lint" for r in lint_ids], check = chk, visibility = ["PUBLIC"])
    _refuse(name = "coverage", why = "coverage is P8: not implemented in this prototype", target_compatible_with = ["buildrules//platforms:not_implemented"], visibility = ["PUBLIC"])

    # 4. actions: the policy's chains of steps
    for act, steps in row["actions"].items():
        _step(name = act, deps = [":" + s for s in steps], visibility = ["PUBLIC"])

def cargo_workspace(path = ".", table = None):
    """The workspace root package: `:check`, the clippy.toml export, and one aggregate target per step and per action.

    Every member listed in the table must have its own package (`<root>/<member path>/BUCK` calling `cargo_package`).
    """
    if table == None:
        fail("cargo_workspace: `table` is required")
    ws = _join(native.package_name(), path) if path not in ("", ".") else native.package_name()
    rows = table["PACKAGES"]
    if table["WORKSPACE"]["clippy_conf"]:
        native.export_file(name = "clippy.toml", src = "clippy.toml", visibility = ["PUBLIC"])
    for f in ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml"]:
        native.export_file(name = f, src = f, visibility = ["PUBLIC"])

    # :check: the sha256 of every input the table was generated from, compared in one action; the expected values are the table's.
    files, hashes, names = [], [], []
    for rel, h in sorted(table["MANIFEST_SHA256"].items()):
        files.append(":" + rel if rel in ("Cargo.toml", "rust-toolchain.toml") else "//" + _join(ws, rel.rsplit("/", 1)[0]) + ":Cargo.toml")
        hashes.append(h)
        names.append(_join(ws, rel))
    files.append(":Cargo.lock")
    hashes.append(table["CARGO_LOCK_SHA256"])
    names.append(_join(ws, "Cargo.lock"))
    _check(name = "check", files = files, hashes = hashes, names = names, visibility = ["PUBLIC"])
    names = sorted(rows)
    for step in ["lint", "debug", "test", "release"]:
        _step(name = step, deps = ["//" + _join(ws, rows[n]["path"]) + ":" + step for n in names], visibility = ["PUBLIC"])
    acts = {}
    for n in names:
        for a in rows[n]["actions"]:
            acts.setdefault(a, []).append("//" + _join(ws, rows[n]["path"]) + ":" + a)
    for a, deps in sorted(acts.items()):
        _step(name = a, deps = deps, visibility = ["PUBLIC"])

# ---- :check ----------------------------------------------------------------------

# `check digest` (rules/check): the arguments come in triples, the expected sha256, the file and the name to report. Every file that is not what the
# table was generated from is said by name with the digest it has (status 1, and no output); only when all match is the output written.
_SUCCESS = '{"version": 1, "data": {"status": "success"}}\n'

def _check_impl(ctx):
    out = ctx.actions.declare_output("table_in_sync")
    args = cmd_args(ctx.attrs._check_exe[RunInfo], "digest", "--out", out.as_output(), "--stamp", _SUCCESS)
    for h, f, n in zip(ctx.attrs.hashes, ctx.attrs.files, ctx.attrs.names):
        args.add("sha256:" + h, f[DefaultInfo].default_outputs[0], "STALE " + n + " (run `buildrules sync` and commit the regenerated table)")
    ctx.actions.run(args, category = "cargo_table_check", identifier = ctx.label.name)
    return [DefaultInfo(default_output = out)]

_check = rule(
    impl = _check_impl,
    attrs = {
        "files": attrs.list(attrs.dep()),
        "hashes": attrs.list(attrs.string()),
        "names": attrs.list(attrs.string()),
        "_check_exe": attrs.exec_dep(default = "buildrules//rules/check:check", providers = [RunInfo]),
    },
)

# The same rule under a public name, for the stale-table case of ci/planted.
cargo_table_check = _check
