load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The refusals of rules/rust/cargo.bzl (check_toolchain) and the plan of `:fmt` (rules/rust/fmt.bzl), as targets: each is green only if the input is refused
# (or accepted, and planned) as stated.
# They are analysis tests; see rules/rust/refusal.bzl. The same refusal through the front door is
# //examples/unpinned/crates/app:unpinned_rustc_is_refused.
load("//rules/rust:pins.bzl", "RUST_DEFAULT", "RUST_OLDEST", "RUST_VERSIONS")
load("//rules/rust:refusal.bzl", "refusal_test")
load("//rules/rust:fmt.bzl", "workspace_config_candidates")
load(":cases.bzl", "MID_EDITION", "NEW_EDITION", "OLD_EDITION", "coverage_refused", "edge_refusals", "edge_unit", "edges_mismatch", "fmt_plan_mismatch", "fmt_refusals", "globs_mismatch", "refused", "same", "table", "unit", "ws_config_of")

# A pinned version with the hashes the pins file has: accepted.
refusal_test(name = "pinned_is_accepted", refusals = refused(table(RUST_DEFAULT, "builtin")), none = True, visibility = ["PUBLIC"])

# Every older pinned version, too.
refusal_test(name = "every_pinned_version_is_accepted", refusals = [m for v in RUST_VERSIONS for m in refused(table(v, "builtin"))], none = True, visibility = ["PUBLIC"])

# A version the user pinned in buildrules-pins.toml, with the origin the generator records: accepted.
refusal_test(name = "user_pin_is_accepted", refusals = refused(table("1.2.3", "buildrules-pins.toml")), none = True, visibility = ["PUBLIC"])

# A Rust nobody pins, in a table whose record says builtin (a table made when that version was pinned): refused, with the way out.
refusal_test(
    name = "unpinned_builtin_is_refused",
    refusals = refused(table("1.2.3", "builtin")),
    contains = ["does not pin", "1.2.3", "buildrules-pins.toml", "buildrules sync"],
    visibility = ["PUBLIC"],
)

# A table with no toolchain record at all (made before the toolchain lock): an unpinned version is refused.
refusal_test(
    name = "unpinned_without_record_is_refused",
    refusals = refused({"RUSTC": "1.2.3"}),
    contains = ["does not pin"],
    visibility = ["PUBLIC"],
)

# A pinned version whose recorded hashes are not the pinned ones: refused (a pin bump is a visible diff in the table).
refusal_test(
    name = "recorded_hashes_must_be_the_pinned_ones",
    refusals = refused(table(RUST_DEFAULT, "builtin", {k: "cd" * 32 for k in ["rustc", "rust_std", "cargo", "clippy"]})),
    contains = ["other hashes", "buildrules sync"],
    visibility = ["PUBLIC"],
)

# A pinned version claimed by the user's own file: the reviewed hashes win, so the record must say builtin.
refusal_test(
    name = "pinned_version_with_user_origin_is_refused",
    refusals = refused(table(RUST_DEFAULT, "buildrules-pins.toml")),
    contains = ["other hashes"],
    visibility = ["PUBLIC"],
)

# The same refusal through the front door and the consumer's own table is in //examples/unpinned/crates/app.

# A member's `:coverage` (rules/rust/cargo.bzl, `check_coverage_toolchain`) needs the llvm-tools of its rustc: the default release pins them, so it is accepted;
# a release of the pins without them (the oldest) and a release the user pinned in buildrules-pins.toml (which pins no llvm-tools) are refused, naming the
# release and the pins file. The same refusal for a release a platform selects is ci/negative.bzl's CASES row on crates//crates/covdemo:coverage.
refusal_test(name = "coverage_with_llvm_tools_is_accepted", refusals = coverage_refused(RUST_DEFAULT), none = True, visibility = ["PUBLIC"])

refusal_test(
    name = "coverage_without_llvm_tools_is_refused",
    refusals = coverage_refused(RUST_OLDEST) + coverage_refused("1.2.3"),
    contains = ["coverage needs the llvm-tools component (llvm-profdata, llvm-cov) of rustc " + RUST_OLDEST + ", which rules/rust/pins.bzl does not pin", "of rustc 1.2.3,"],
    visibility = ["PUBLIC"],
)

# ---- the dependency edges of a member's unit (rules/rust/cargo.bzl, `unit_deps`) -----------------------------------------------------------------------
# The units are the shapes cargo's unit graph has (`cargo test --unit-graph`); the ids are made up. examples/crates builds both shapes through the front door:
# crates/selfdev (a dev-dependency on the package itself) and crates/linkuser (a build script reading two dependencies with `links`).

# A dev-dependency on the package itself that turns on a feature: an integration test lists the same edge to the library twice. One dependency.
refusal_test(
    name = "edges_take_the_same_edge_listed_twice_once",
    refusals = edges_mismatch(
        edge_unit("test", [["pkg", "pkg:lib"], ["pkg", "pkg:lib"]], kind = "test", name = "it"),
        {"pkg:lib": edge_unit("build")},
        {"deps": {"pkg": ":pkg:lib"}, "link_deps": []},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

# Two different units under one name are still refused, by the package and the name: the dependency rustc would get is not decided.
refusal_test(
    name = "edges_refuse_two_units_under_one_name",
    refusals = edge_refusals(
        edge_unit("build", [["dep", "dep:a"], ["dep", "dep:b"]]),
        {"dep:a": edge_unit("build"), "dep:b": edge_unit("build")},
    ),
    contains = ["pkg: two dependencies named dep"],
    visibility = ["PUBLIC"],
)

# A build script's run that depends on the runs of dependencies with `links` (a member's and a registry crate's): those are its link_deps, in the table's
# order, and its one dependency is its own compiled script.
refusal_test(
    name = "edges_make_the_runs_of_links_dependencies_link_deps",
    refusals = edges_mismatch(
        edge_unit("run-custom-build", [["build_script_build", "pkg:script"], ["build_script_build", "member:run"], ["build_script_build", "zstd:run"]], kind = "custom-build"),
        {
            "member:run": edge_unit("run-custom-build", kind = "custom-build", links = "member"),
            "pkg:script": edge_unit("build", kind = "custom-build"),
            "zstd:run": edge_unit("run-custom-build", kind = "custom-build", links = "zstd"),
        },
        {"deps": {"build_script_build": ":pkg:script"}, "link_deps": [":member:run", ":zstd:run"]},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

# A run that depends on the run of a package without `links` has no metadata to read from it: refused, naming the run.
refusal_test(
    name = "edges_refuse_the_run_of_a_package_without_links",
    refusals = edge_refusals(
        edge_unit("run-custom-build", [["build_script_build", "pkg:script"], ["build_script_build", "plain:run"]], kind = "custom-build"),
        {"pkg:script": edge_unit("build", kind = "custom-build"), "plain:run": edge_unit("run-custom-build", kind = "custom-build")},
    ),
    contains = ["pkg: depends on the run of plain:run, which has no links"],
    visibility = ["PUBLIC"],
)

# Only a run's dependencies on runs are link_deps: a compile that depends on its package's script run keeps it as a dependency, by extern name, even when
# the package has `links`; a binary of the package is keyed `bin:<name>`.
refusal_test(
    name = "edges_keep_a_compiles_script_run_and_binaries_as_deps",
    refusals = edges_mismatch(
        edge_unit("test", [["build_script_build", "pkg:run"], ["dep", "dep:lib"], ["tool", "pkg:bin"]], kind = "test", name = "it"),
        {
            "dep:lib": edge_unit("build"),
            "pkg:bin": edge_unit("build", kind = "bin", name = "tool"),
            "pkg:run": edge_unit("run-custom-build", kind = "custom-build", links = "pkg"),
        },
        {"deps": {"bin:tool": ":pkg:bin", "build_script_build": ":pkg:run", "dep": ":dep:lib"}, "link_deps": []},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

# ---- the sources of a member's unit (rules/rust/cargo.bzl, `globs_for`) -------------------------------------------------------------------------------
# examples/crates/crates/hook builds the first case through the front door: a `[[bin]]` at tests/bin/example_hook.rs, which its integration test runs.

# A target whose root is in another top directory than its kind's has that directory too: a `[[bin]]` under tests/, a `[[test]]` under src/, a
# `[[bin]]` outside both, a library whose root is outside src/.
refusal_test(
    name = "globs_give_a_target_the_top_directory_of_its_root",
    refusals = globs_mismatch([
        ("bin", "tests/bin/example_hook.rs", ["src/**", "tests/**"]),
        ("test", "src/check.rs", ["tests/**", "src/**"]),
        ("bin", "tools/lambda/canary/main.rs", ["src/**", "tools/**"]),
        ("lib", "lib/core.rs", ["src/**", "build.rs", "lib/**"]),
    ]),
    none = True,
    visibility = ["PUBLIC"],
)

# The conventional layouts are unchanged: a library has src/ and build.rs, a binary src/, an integration test tests/, a build script the whole package
# wherever its root is; a root at the top of the package adds no directory.
refusal_test(
    name = "globs_of_the_conventional_layouts",
    refusals = globs_mismatch([
        ("lib", "src/lib.rs", ["src/**", "build.rs"]),
        ("bin", "src/main.rs", ["src/**"]),
        ("bin", "src/bin/tool/main.rs", ["src/**"]),
        ("test", "tests/it.rs", ["tests/**"]),
        ("test", "tests/suite/main.rs", ["tests/**"]),
        ("custom-build", "build.rs", ["**"]),
        ("custom-build", "tools/build.rs", ["**"]),
        ("bin", "main.rs", ["src/**"]),
    ]),
    none = True,
    visibility = ["PUBLIC"],
)

# ---- :fmt (rules/rust/fmt.bzl): which roots, editions and config rustfmt is given, and what is refused ------------------------------------------------

# The table's roots, each once (a library and its test binary share src/lib.rs), sorted, under the edition of their unit; a bin with an edition of its own
# gets its own group.
refusal_test(
    name = "fmt_takes_each_table_root_once_under_its_edition",
    refusals = fmt_plan_mismatch(
        [unit("src/lib.rs"), unit("src/lib.rs"), unit("tests/it.rs"), unit("build.rs"), unit("src/bin/old.rs", OLD_EDITION)],
        [],
        [],
        {"config": None, "roots": {OLD_EDITION: ["src/bin/old.rs"], MID_EDITION: ["build.rs", "src/lib.rs", "tests/it.rs"]}},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

# An example and a bench (no unit in the table) are checked too, under the edition most of the units have; a discovered root that is in the table keeps
# its unit's edition.
refusal_test(
    name = "fmt_adds_discovered_examples_and_benches_under_the_package_edition",
    refusals = fmt_plan_mismatch(
        [unit("src/lib.rs", NEW_EDITION), unit("src/lib.rs", NEW_EDITION), unit("src/bin/old.rs", OLD_EDITION)],
        ["benches/speed.rs", "examples/demo/main.rs", "src/bin/old.rs", "src/lib.rs"],
        [],
        {"config": None, "roots": {OLD_EDITION: ["src/bin/old.rs"], NEW_EDITION: ["benches/speed.rs", "examples/demo/main.rs", "src/lib.rs"]}},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

# The member directory's own config is the one passed; with both names there, `.rustfmt.toml` (rustfmt reads it first). A config in a directory that holds
# no root (a test fixture's) is not one cargo fmt reads, and is accepted.
refusal_test(
    name = "fmt_reads_the_member_config_dot_name_first",
    refusals = fmt_plan_mismatch(
        [unit("src/lib.rs")],
        [],
        ["rustfmt.toml", ".rustfmt.toml", "tests/fixtures/rustfmt.toml"],
        {"config": ".rustfmt.toml", "roots": {MID_EDITION: ["src/lib.rs"]}},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

refusal_test(
    name = "fmt_reads_the_member_config",
    refusals = fmt_plan_mismatch([unit("src/lib.rs")], [], ["rustfmt.toml"], {"config": "rustfmt.toml", "roots": {MID_EDITION: ["src/lib.rs"]}}),
    none = True,
    visibility = ["PUBLIC"],
)

# A config in a directory above a root and below the member directory: cargo fmt reads it for that root, `:fmt` would not, so it is refused by name.
refusal_test(
    name = "fmt_refuses_a_config_between_the_member_and_a_root",
    refusals = fmt_refusals([unit("src/lib.rs"), unit("src/bin/tool/main.rs")], [], ["src/bin/rustfmt.toml"]),
    contains = ["src/bin/rustfmt.toml is the rustfmt config of src/bin/tool/main.rs under `cargo fmt`", "move its settings"],
    visibility = ["PUBLIC"],
)

# The same for a discovered root (an example).
refusal_test(
    name = "fmt_refuses_a_config_above_a_discovered_root",
    refusals = fmt_refusals([unit("src/lib.rs")], ["examples/demo.rs"], ["examples/.rustfmt.toml"]),
    contains = ["examples/.rustfmt.toml is the rustfmt config of examples/demo.rs"],
    visibility = ["PUBLIC"],
)

# A target root outside the member directory, and a member with no unit: refused by name.
refusal_test(
    name = "fmt_refuses_a_root_outside_the_member",
    refusals = fmt_refusals([unit("src/lib.rs"), unit("../shared/main.rs")]),
    contains = ["the target root ../shared/main.rs is outside the member's directory"],
    visibility = ["PUBLIC"],
)

# Every spelling of a path that leaves the member: absolute, a `..` in the middle, a trailing `..`.
refusal_test(
    name = "fmt_refuses_an_absolute_root",
    refusals = fmt_refusals([unit("/etc/main.rs")]),
    contains = ["the target root /etc/main.rs is outside the member's directory"],
    visibility = ["PUBLIC"],
)

refusal_test(
    name = "fmt_refuses_a_root_through_dot_dot",
    refusals = fmt_refusals([unit("src/../../x.rs")]),
    contains = ["the target root src/../../x.rs is outside"],
    visibility = ["PUBLIC"],
)

# Two editions with as many units each: the discovered root takes the lower edition (a stable choice, never the order of the table).
refusal_test(
    name = "fmt_breaks_an_edition_tie_by_the_lower_edition",
    refusals = fmt_plan_mismatch(
        [unit("src/main.rs", NEW_EDITION), unit("src/lib.rs", MID_EDITION)],
        ["examples/demo.rs"],
        [],
        {"config": None, "roots": {MID_EDITION: ["examples/demo.rs", "src/lib.rs"], NEW_EDITION: ["src/main.rs"]}},
    ),
    none = True,
    visibility = ["PUBLIC"],
)

refusal_test(
    name = "fmt_refuses_a_member_without_units",
    refusals = fmt_refusals([], ["src/lib.rs"]),
    contains = ["has no units in the table"],
    visibility = ["PUBLIC"],
)

# The workspace root's config (`.rustfmt.toml` first), none when there is none, and a config in a directory between the root and a member refused by name.
refusal_test(
    name = "fmt_workspace_config_is_the_root_one",
    refusals = same("workspace_fmt_config", ws_config_of(["crates/a", "b"], ["rustfmt.toml", ".rustfmt.toml"]), (".rustfmt.toml", [])),
    none = True,
    visibility = ["PUBLIC"],
)

refusal_test(
    name = "fmt_workspace_without_config_has_none",
    refusals = same("workspace_fmt_config", ws_config_of(["crates/a"], []), (None, [])),
    none = True,
    visibility = ["PUBLIC"],
)

refusal_test(
    name = "fmt_workspace_refuses_a_config_between_the_root_and_a_member",
    refusals = ws_config_of(["crates/deep/a", "b"], ["rustfmt.toml", "crates/rustfmt.toml"])[1],
    contains = ["crates/rustfmt.toml is the rustfmt config of the member crates/deep/a under `cargo fmt`"],
    visibility = ["PUBLIC"],
)

# The paths the workspace globs for: both names in the root and in every directory between it and each member, and not in the member directory itself
# (that one is the member's to read).
refusal_test(
    name = "fmt_workspace_globs_the_root_and_each_directory_above_a_member",
    refusals = same("workspace_config_candidates", workspace_config_candidates(["crates/deep/a", "b"]), [
        ".rustfmt.toml",
        "crates/.rustfmt.toml",
        "crates/deep/.rustfmt.toml",
        "crates/deep/rustfmt.toml",
        "crates/rustfmt.toml",
        "rustfmt.toml",
    ]),
    none = True,
    visibility = ["PUBLIC"],
)

scrub_files()
