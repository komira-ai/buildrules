load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The refusals of the rules every family shares (rules/core), as analysis tests (rules/rust/refusal.bzl): a download that is not pinned, a rerun request, a
# download mirror, a test's data and environment. Each is green only if the rule refused, with the message that says what to write instead; the accepted form of
# each is beside it, so a check that refuses everything is red too.
load("//rules/core:hang_limit.bzl", "HANG_LIMIT_S", "check_hang_limit", "check_hang_limits", "hang_limit_args", "hang_limit_flags", "hang_limit_of")
load("//rules/core:pinned_file.bzl", "check_pinned")
load("//rules/core:rerun.bzl", "parse_rerun")
load("//rules/core:test_runtime.bzl", "check_data_destinations", "env_args", "gate_mojo", "macos_library_dirs")
load("//rules/core:url_map.bzl", "map_url")
load("//rules/core:platform.bzl", "LINUX_X86_64")
load("//rules/rust:refusal.bzl", "accepts", "refuses")
load("//rules:matrix.bzl", "group")
load("//rules/zig:zig.bzl", "zig_module", "zig_test")

_ALL = []

_SHA = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
_WHO = "//rules/pins:zig"

# ---- pinned_file: a download without its pin --------------------------------------------------------------------------------------------------------

_ALL.append(accepts("pinned_file_with_hash_and_size_is_accepted", check_pinned, [_WHO, _SHA, 3]))

_ALL.append(refuses("pinned_file_without_a_size_is_refused", check_pinned, [_WHO, _SHA, 0], ["pinned_file //rules/pins:zig", "`size_bytes` must be the file's positive length"]))

_ALL.append(refuses("pinned_file_with_a_negative_size_is_refused", check_pinned, [_WHO, _SHA, -1], ["`size_bytes` must be the file's positive length"]))

_ALL.append(refuses("pinned_file_with_an_empty_hash_is_refused", check_pinned, [_WHO, "", 3], ["`sha256` must be 64 lower-case hex digits", "\"\""]))

_ALL.append(refuses("pinned_file_with_a_short_hash_is_refused", check_pinned, [_WHO, _SHA[:40], 3], ["`sha256` must be 64 lower-case hex digits"]))

_ALL.append(refuses("pinned_file_with_an_upper_case_hash_is_refused", check_pinned, [_WHO, _SHA.upper(), 3], ["`sha256` must be 64 lower-case hex digits"]))

_ALL.append(refuses("pinned_file_with_a_hash_that_is_not_hex_is_refused", check_pinned, [_WHO, "z" * 64, 3], ["`sha256` must be 64 lower-case hex digits"]))

# ---- [buildrules_re] macos_library_dirs: absolute directories, ':' or white space between them ---------------------------------------------------------

_ALL.append(accepts("macos_library_dirs_absolute_are_accepted", macos_library_dirs, ["/opt/x/lib:/opt/y/lib /opt/z/lib"]))

_ALL.append(accepts("macos_library_dirs_absent_is_accepted", macos_library_dirs, [""]))

_ALL.append(refuses("macos_library_dirs_relative_is_refused", macos_library_dirs, ["/opt/x/lib lib"], ["macos_library_dirs: \"lib\" is not an absolute directory"]))

# The value passed to the runners: ':' between the directories, in the order given, whatever separated them in the key; nothing for an absent key.
[
    fail("macos_library_dirs({}) is {}, not {}".format(repr(raw), repr(macos_library_dirs(raw)), repr(want)))
    for raw, want in [
        ("", ""),
        ("  ", ""),
        ("/a", "/a"),
        ("/a /b", "/a:/b"),
        ("/a:/b", "/a:/b"),
        (" /a::/b  /c ", "/a:/b:/c"),
    ]
    if macos_library_dirs(raw) != want
]

# ---- [buildrules] rerun -----------------------------------------------------------------------------------------------------------------------------

_ALL.append(accepts("rerun_one_target_is_accepted", parse_rerun, ["buildrules//rules/gate:gate#1"]))

_ALL.append(accepts("rerun_several_targets_are_accepted", parse_rerun, ["buildrules//a:a#1, crates//b:b#12"]))

_ALL.append(refuses("rerun_without_a_number_is_refused", parse_rerun, ["buildrules//rules/gate:gate"], ["has no `#<n>`", "<cell>//<package>:<name>#<n>"]))

_ALL.append(refuses("rerun_with_number_zero_is_refused", parse_rerun, ["buildrules//rules/gate:gate#0"], ["`0` is not a whole number from 1"]))

_ALL.append(refuses("rerun_with_a_word_for_a_number_is_refused", parse_rerun, ["buildrules//rules/gate:gate#once"], ["`once` is not a whole number from 1"]))

_ALL.append(refuses("rerun_without_the_cell_is_refused", parse_rerun, ["//rules/gate:gate#1"], ["name the cell"]))

_ALL.append(refuses("rerun_with_a_subtarget_is_refused", parse_rerun, ["buildrules//rules/gate:gate[out]#1"], ["name the target, without a sub-target or a configuration"]))

_ALL.append(refuses("rerun_with_a_label_that_is_not_one_is_refused", parse_rerun, ["buildrules//rules/gate#1"], ["is not a target label"]))

_ALL.append(refuses("rerun_with_an_empty_entry_is_refused", parse_rerun, ["buildrules//a:a#1,,buildrules//b:b#1"], ["an empty entry"]))

_ALL.append(refuses("rerun_naming_a_target_twice_is_refused", parse_rerun, ["buildrules//a:a#1,buildrules//a:a#2"], ["buildrules//a:a is named twice"]))

# ---- buildrules.url_map ----------------------------------------------------------------------------------------------------------------------------

_ALL.append(accepts("url_map_pair_is_accepted", map_url, ["https://a.example/=https://mirror.example/", "https://a.example/x.tgz"]))

_ALL.append(refuses("url_map_without_equals_is_refused", map_url, ["https://a.example/", "https://a.example/x.tgz"], ["buildrules.url_map: `https://a.example/` is not <from-prefix>=<to-prefix>"]))

# ---- a test's data and environment ----------------------------------------------------------------------------------------------------------------

_ALL.append(accepts("data_destinations_are_accepted", check_data_destinations, ["//t:t", ["a.txt", "dir/b.txt", "dir2/c/d.txt"]]))

_ALL.append(refuses("data_destination_absolute_is_refused", check_data_destinations, ["//t:t", ["/etc/passwd"]], ["data destination \"/etc/passwd\" must be a relative file path"]))

_ALL.append(refuses("data_destination_empty_is_refused", check_data_destinations, ["//t:t", [""]], ["must be a relative file path"]))

_ALL.append(refuses("data_destination_ending_in_a_slash_is_refused", check_data_destinations, ["//t:t", ["dir/"]], ["must be a relative file path"]))

_ALL.append(refuses("data_destination_with_dotdot_is_refused", check_data_destinations, ["//t:t", ["a/../../b"]], ["holds an empty, `.` or `..` segment"]))

_ALL.append(refuses("data_destination_with_an_empty_segment_is_refused", check_data_destinations, ["//t:t", ["a//b"]], ["holds an empty, `.` or `..` segment"]))

# Staging a file at `a` and another at `a/b` would make `a` both: the second would overwrite or fail inside the tree.
_ALL.append(refuses("data_destination_file_and_directory_is_refused", check_data_destinations, ["//t:t", ["a", "a/b"]], ["data destination \"a\" is both a file and the directory of \"a/b\""]))

_ALL.append(accepts("env_names_are_accepted", env_args, ["//t:t", {"MY_VAR": "1", "_x2": "y"}]))

_ALL.append(refuses("env_name_with_a_dash_is_refused", env_args, ["//t:t", {"MY-VAR": "1"}], ["env name \"MY-VAR\" is not a shell variable name"]))

_ALL.append(refuses("env_name_starting_with_a_digit_is_refused", env_args, ["//t:t", {"1VAR": "1"}], ["is not a shell variable name"]))

_ALL += [
    refuses("env_name_{}_is_refused".format(n.lower()), env_args, ["//t:t", {n: "x"}], ["env sets " + n + ", which the test runner sets itself"])
    for n in ["PATH", "LD_PRELOAD", "TMPDIR", "HOME"]
]

# ---- the hang limit of a welded test (rules/core/hang_limit.bzl, docs/contract.md section 12.8) ------------------------------------------------------------

_ALL.append(accepts("hang_limit_of_a_whole_number_of_seconds_is_accepted", check_hang_limit, ["//t:t", 3600]))

_ALL += [
    refuses("hang_limit_{}_is_refused".format(name), check_hang_limit, ["//t:t", value], ["test_hang_limit_s {} is not a positive whole number of seconds".format(shown), "never lower it to make a test pass"])
    for name, value, shown in [("zero", 0, "0"), ("negative", -5, "-5"), ("text", "300", "\"300\""), ("true", True, "True")]
]

_TESTS = ["tests/test_a.mojo", "tests/test_b.mojo"]

_ALL.append(accepts("hang_limits_of_the_star_and_of_a_test_are_accepted", check_hang_limits, ["//t:t", {"*": 3000, "tests/test_b.mojo": 7200}, _TESTS]))

_ALL.append(accepts("no_hang_limits_are_accepted", check_hang_limits, ["//t:t", {}, _TESTS]))

_ALL.append(refuses("hang_limit_of_an_unknown_test_is_refused", check_hang_limits, ["//t:t", {"tests/test_c.mojo": 60}, _TESTS], ["test_hang_limit_s names \"tests/test_c.mojo\", which is `*` or a test of the package"]))

_ALL.append(refuses("hang_limit_of_a_test_with_a_bad_value_is_refused", check_hang_limits, ["//t:t", {"tests/test_a.mojo": 0}, _TESTS], ["test_hang_limit_s[\"tests/test_a.mojo\"]", "is not a positive whole number of seconds"]))

_ALL.append(refuses("hang_limits_that_are_not_a_dict_are_refused", check_hang_limits, ["//t:t", 60, _TESTS], ["test_hang_limit_s must be a dict"]))

_TC = struct(gate = "gate", busybox = "bb", compiler = "compiler")

# The default is half an hour, a test's own entry wins over `*`, and `*` over the default; the options are the ones `check marker` and `gate mojo` read.
[
    fail("{} is {}, not {}".format(what, repr(got), repr(want)))
    for what, got, want in [
        ("HANG_LIMIT_S", HANG_LIMIT_S, 1800),
        ("hang_limit_of with no entry", hang_limit_of({}, "tests/test_a.mojo"), 1800),
        ("hang_limit_of with the star", hang_limit_of({"*": 3000}, "tests/test_a.mojo"), 3000),
        ("hang_limit_of with the test's own entry", hang_limit_of({"*": 3000, "tests/test_a.mojo": 7200}, "tests/test_a.mojo"), 7200),
        ("hang_limit_of with the entry of another test", hang_limit_of({"tests/test_b.mojo": 7200}, "tests/test_a.mojo"), 1800),
        ("hang_limit_args", hang_limit_args("//t:t", 90), ["--hang-limit-s", "90", "--hang-label", "//t:t"]),
        ("hang_limit_flags", hang_limit_flags(90), ["--hang-limit-s", "90"]),
        # The command of `gate mojo` a consumer's rule builds: the limit is on it by default, the target's own wins, and None (a coverage run) leaves it off.
        ("gate_mojo by default", "\"--hang-limit-s\", \"1800\"" in str(gate_mojo(_TC, "//t:t", "t", "m")), True),
        ("gate_mojo with a limit", "\"--hang-limit-s\", \"90\"" in str(gate_mojo(_TC, "//t:t", "t", "m", test_hang_limit_s = 90)), True),
        ("gate_mojo with a limit, the default", "\"--hang-limit-s\", \"1800\"" in str(gate_mojo(_TC, "//t:t", "t", "m", test_hang_limit_s = 90)), False),
        ("gate_mojo without a limit", "--hang-limit-s" in str(gate_mojo(_TC, "//t:t", "t", "m", test_hang_limit_s = None)), False),
    ]
    if got != want
]

# ---- the process tests of the refusals of the tools (rules/*/tests/*_refuse_test.zig) ----------------------------------------------------------------
#
# `refusal_proc` runs a built tool as a child and holds its exit status and its message to what the tool must say when it refuses. It is a module behind its own
# test, so no refusal test imports it unless it passed.
zig_test(
    name = "proc_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "proc.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

zig_module(
    name = "refusal_proc",
    src = "proc.zig",
    unit_tests = [":proc_unit"],
    visibility = ["PUBLIC"],
)

# Every refusal of this package, for //ci:refusals.
group(name = "all", deps = _ALL + [":proc_unit", ":refusal_proc"], visibility = ["PUBLIC"])

scrub_files()
