load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("//rules/core:platform.bzl", "TOOL_EXEC")
load(":zig.bzl", "zig_bootstrap_exe", "zig_exe")

# The runner of every `zig_test` action (zig_launch.zig). Built by the pinned zig directly (no
# shell, no busybox), behind its unit tests, because the rules that run it cannot build it.
zig_bootstrap_exe(
    name = "zig_launch",
    exec_compatible_with = TOOL_EXEC,
    src = "zig_launch.zig",
    test_src = "zig_launch_test.zig",
    zig = "buildrules//rules/pins:zig",
    visibility = ["PUBLIC"],
)

# Unpacks the conda packages `conda_libs` takes shared libraries from.
zig_exe(
    name = "conda_unpack",
    exec_compatible_with = TOOL_EXEC,
    src = "conda_unpack.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig",
    visibility = ["PUBLIC"],
)

# Read by the buildrules.dev site's tests (site/BUCK), which check its pages against this file.
export_file(
    name = "zig.bzl",
    src = "zig.bzl",
    visibility = ["//site:"],
)

scrub_files()
