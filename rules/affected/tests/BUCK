# The tests of the selector library (rules/affected).
#
# Refusals: `affected_config` as analysis tests (rules/rust/refusal.bzl). Each `refuses` target is green only if the configuration was
# refused with the words that name the bad field; each `accepts` target only if it was not refused at all.
#
# Table cases: `table_problems()` (cases.bzl) over graphs written out there. A case that answers otherwise fails the load of this
# package with its name, so every target here (and //ci:refusals) is red until it holds again.

load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("//rules:matrix.bzl", "group")
load("//rules/affected:defs.bzl", "affected_config", "held_config")
load("//rules/rust:refusal.bzl", "accepts", "refuses")
load(":cases.bzl", "table_problems")

[fail(p) for p in table_problems()]

_U = ["t//..."]
_AGG = "t//ci:pr"
_HEAVY_ROW = ("t//src/h:heavy", ["src/h/**"], ["t//src/h:h_root"], "one compile")

_ALL = [
    accepts("minimal_config_is_accepted", affected_config, [], kwargs = dict(universe = _U, aggregate = _AGG)),
    accepts("config_with_every_field_is_accepted", affected_config, [], kwargs = dict(
        universe = _U,
        aggregate = _AGG,
        default = "t//ci:pr_default",
        excluded = [("t//slow/...", "too slow for a pull request")],
        heavy = [_HEAVY_ROW],
        widen = [("tools/build/**", "the build system")],
        inert = ["*.md"],
        held = held_config(file = "held_marker", message = "a held metric stays held"),
        where = struct(excluded = "the rows file EXCLUDED", heavy = "the rows file HEAVY"),
    )),
    accepts("default_without_heavy_is_accepted", affected_config, [], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:pr_default")),
    refuses("empty_universe_is_refused", affected_config, [], ["affected_config: universe is a non-empty list"], kwargs = dict(universe = [], aggregate = _AGG)),
    refuses("universe_as_a_string_is_refused", affected_config, [], ["affected_config: universe is a non-empty list", '"t//..."'], kwargs = dict(universe = "t//...", aggregate = _AGG)),
    refuses("universe_entry_not_a_string_is_refused", affected_config, [], ["affected_config: universe holds target patterns"], kwargs = dict(universe = ["t//...", 3], aggregate = _AGG)),
    refuses("aggregate_without_colon_is_refused", affected_config, [], ["affected_config: aggregate is a label", '"t//ci"'], kwargs = dict(universe = _U, aggregate = "t//ci")),
    refuses("aggregate_without_slashes_is_refused", affected_config, [], ["affected_config: aggregate is a label", '"ci:pr"'], kwargs = dict(universe = _U, aggregate = "ci:pr")),
    refuses("aggregate_with_colon_only_before_slashes_is_refused", affected_config, [], ["affected_config: aggregate is a label"], kwargs = dict(universe = _U, aggregate = "t:x//ci")),
    refuses("default_not_a_string_is_refused", affected_config, [], ["affected_config: default is a label"], kwargs = dict(universe = _U, aggregate = _AGG, default = None)),
    refuses("widen_row_of_one_element_is_refused", affected_config, [], ["affected_config: widen row", "is not (pattern, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, widen = [("tools/**",)])),
    refuses("widen_not_a_list_is_refused", affected_config, [], ["affected_config: widen is a list"], kwargs = dict(universe = _U, aggregate = _AGG, widen = "tools/**")),
    refuses("excluded_row_not_a_tuple_is_refused", affected_config, [], ["affected_config: excluded row", "is not (pattern, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, excluded = ["t//slow/..."])),
    refuses("inert_entry_not_a_string_is_refused", affected_config, [], ["affected_config: an inert entry is a pattern"], kwargs = dict(universe = _U, aggregate = _AGG, inert = ["*.md", ("*.txt", "why")])),
    refuses("inert_not_a_list_is_refused", affected_config, [], ["affected_config: inert is a list"], kwargs = dict(universe = _U, aggregate = _AGG, inert = "*.md")),
    refuses("heavy_row_of_three_elements_is_refused", affected_config, [], ["affected_config: a heavy row is (target, own, roots, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = [_HEAVY_ROW[:3]])),
    refuses("heavy_row_without_roots_is_refused", affected_config, [], ["affected_config: a heavy row is (target, own, roots, reason)", "non-empty list"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = [(_HEAVY_ROW[0], _HEAVY_ROW[1], [], "r")])),
    refuses("heavy_not_a_list_is_refused", affected_config, [], ["affected_config: heavy is a list of (target, own, roots, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = "t//src/h:heavy")),
    refuses("heavy_row_with_own_as_a_string_is_refused", affected_config, [], ["affected_config: a heavy row is (target, own, roots, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = [(_HEAVY_ROW[0], "src/h/**", _HEAVY_ROW[2], "r")])),
    refuses("heavy_row_with_a_target_not_a_string_is_refused", affected_config, [], ["affected_config: a heavy row is (target, own, roots, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = [(None, _HEAVY_ROW[1], _HEAVY_ROW[2], "r")])),
    refuses("heavy_row_with_a_root_not_a_string_is_refused", affected_config, [], ["affected_config: a heavy row is (target, own, roots, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = [(_HEAVY_ROW[0], _HEAVY_ROW[1], [3], "r")])),
    refuses("heavy_row_with_a_reason_not_a_string_is_refused", affected_config, [], ["affected_config: a heavy row is (target, own, roots, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, default = "t//ci:d", heavy = [(_HEAVY_ROW[0], _HEAVY_ROW[1], _HEAVY_ROW[2], None)])),
    refuses("widen_row_with_a_reason_not_a_string_is_refused", affected_config, [], ["affected_config: widen row", "is not (pattern, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, widen = [("tools/**", 1)])),
    refuses("widen_row_as_a_list_is_refused", affected_config, [], ["affected_config: widen row", "is not (pattern, reason)"], kwargs = dict(universe = _U, aggregate = _AGG, widen = [["tools/**", "why"]])),
    refuses("excluded_not_a_list_is_refused", affected_config, [], ["affected_config: excluded is a list"], kwargs = dict(universe = _U, aggregate = _AGG, excluded = "t//slow/...")),
    refuses("held_with_a_message_not_a_string_is_refused", affected_config, [], ["affected_config: held is None or held_config"], kwargs = dict(universe = _U, aggregate = _AGG, held = held_config(file = "held_marker", message = None))),
    refuses("aggregate_not_a_string_is_refused", affected_config, [], ["affected_config: aggregate is a label"], kwargs = dict(universe = _U, aggregate = None)),
    refuses("heavy_without_default_is_refused", affected_config, [], ["affected_config: heavy rows need default"], kwargs = dict(universe = _U, aggregate = _AGG, heavy = [_HEAVY_ROW])),
    refuses("held_not_a_held_config_is_refused", affected_config, [], ["affected_config: held is None or held_config"], kwargs = dict(universe = _U, aggregate = _AGG, held = "held_marker")),
    refuses("held_with_an_empty_file_is_refused", affected_config, [], ["affected_config: held names its marker file"], kwargs = dict(universe = _U, aggregate = _AGG, held = held_config(file = "", message = "m"))),
    refuses("where_without_heavy_is_refused", affected_config, [], ["affected_config: where is None or struct(excluded, heavy)"], kwargs = dict(universe = _U, aggregate = _AGG, where = struct(excluded = "E"))),
    # Every bad field is refused, not only the first: a recorder sees each message and the call still returns.
    refuses("every_bad_field_is_refused", affected_config, [], [
        "affected_config: universe",
        "affected_config: aggregate",
        "affected_config: widen row",
        "affected_config: heavy rows need default",
    ], kwargs = dict(universe = [], aggregate = "x", widen = [("a",)], heavy = [_HEAVY_ROW])),
]

# Every test of this package, for //ci:refusals.
group(name = "all", deps = _ALL, visibility = ["PUBLIC"])

scrub_files()
