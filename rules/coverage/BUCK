load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The path tools of a kcov coverage run, and kcov built from source with the pinned zig (README.md): static executables built
# with the pinned zig, each gated by its cases, which run as build actions. linux x86_64 only.
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("//rules/core:pinned_file.bzl", "pinned_file")
load("//rules/core:platform.bzl", "LINUX_X86_64")
load("//rules/pins:pins.bzl", "PINS")
load("//rules/zig:zig.bzl", "zig_exe", "zig_test")
load(":defs.bzl", "cov_tool", "kcov_dist")
load(":pins.bzl", "KCOV_PINS")

_ZIG = "buildrules//rules/pins:zig_next"
_ZIG_VERSION = "buildrules//rules/pins:zig_next_version"
_BB = "buildrules//rules/pins:busybox"

# ---- debug_relocate: a directory path in a file overwritten by a placeholder of the same length -----------------
zig_test(
    name = "debug_relocate_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["tools/debug_relocate.zig"],
    src = "tools/debug_relocate_test.zig",
    busybox = _BB,
    zig = _ZIG,
)

zig_exe(
    name = "debug_relocate_exe",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/debug_relocate.zig",
    unit_tests = [":debug_relocate_unit", _ZIG_VERSION],
    zig = _ZIG,
)

zig_test(
    name = "debug_relocate_exe_test",
    exec_compatible_with = LINUX_X86_64,
    env_tools = {"DEBUG_RELOCATE": ":debug_relocate_exe"},
    src = "tools/debug_relocate_exe_test.zig",
    busybox = _BB,
    zig = _ZIG,
)

cov_tool(
    name = "debug_relocate",
    cases = [":debug_relocate_exe_test"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":debug_relocate_exe",
    visibility = ["PUBLIC"],
)

