# ---- kcov v42, built from source (kcov_build.zig) ---------------------------------------------------------------
[
    pinned_file(
        name = KCOV_PINS[role]["name"],
        url = KCOV_PINS[role]["url"],
        sha256 = KCOV_PINS[role]["sha256"],
        size_bytes = KCOV_PINS[role]["size"],
    )
    for role in KCOV_PINS
]

zig_exe(
    name = "conda_payload",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/conda_payload.zig",
    zig = _ZIG,
)

zig_test(
    name = "kcov_build_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["tools/kcov_build.zig"],
    src = "tools/kcov_build_test.zig",
    busybox = _BB,
    zig = _ZIG,
)

zig_exe(
    name = "kcov_build",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/kcov_build.zig",
    unit_tests = [":kcov_build_unit", _ZIG_VERSION],
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# DT_RUNPATH -> DT_RPATH, which zig 0.12 cannot link into an executable.
zig_exe(
    name = "elf_rpath",
    exec_compatible_with = LINUX_X86_64,
    src = "tools/elf_rpath.zig",
    zig = _ZIG,
)

# The distribution: bin/kcov, lib/libgcc_s.so.1 and share/licenses/.
kcov_dist(
    name = "kcov",
    exec_compatible_with = LINUX_X86_64,
    archive = ":" + KCOV_PINS["kcov_src"]["name"],
    conda_payload = ":conda_payload",
    elf_rpath = ":elf_rpath",
    packages = {
        "bzip2": ":" + KCOV_PINS["kcov_bzip2"]["name"],
        "elfutils": ":" + KCOV_PINS["kcov_elfutils"]["name"],
        # libgcc_s.so.1, which glibc's pthread_cancel loads.
        "libgcc": "buildrules//rules/pins:" + PINS["libgcc"]["name"],
        "lzma": ":" + KCOV_PINS["kcov_lzma"]["name"],
        "zlib": ":" + KCOV_PINS["kcov_zlib"]["name"],
        "zstd": ":" + KCOV_PINS["kcov_zstd"]["name"],
    },
    shim = [
        "shim/curl/curl.h",
        "shim/curl_shim.c",
    ],
    strip_prefix = "kcov-42",
    version = "v42",
    zig_triple = "x86_64-linux-gnu.2.34",
    visibility = ["PUBLIC"],
)

