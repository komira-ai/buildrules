# ---- zig_cover and cov_floor: the coverage of a Zig package's tests, and the floor it is held to (zig_cover.bzl) ----------------------------
# The test runner of a coverage build: `zig test --test-runner`, run by zig_cover as a source file (it is compiled with each test).
export_file(
    name = "zig_cov_runner.zig",
    src = "tools/zig_cov_runner.zig",
    visibility = ["PUBLIC"],
)

zig_test(
    name = "zig_cover_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = [
        "tools/zig_cover.zig",
        "tools/cov_run.zig",
    ],
    src = "tools/zig_cover_test.zig",
    busybox = _BB,
    zig = _ZIG,
)

zig_exe(
    name = "zig_cover_exe",
    exec_compatible_with = LINUX_X86_64,
    imports = ["tools/cov_run.zig"],
    src = "tools/zig_cover.zig",
    unit_tests = [":zig_cover_unit", _ZIG_VERSION],
    zig = _ZIG,
)

# The executable as a process over small packages of known coverage, with the pinned zig, kcov and cov_normalize. A validation of :zig_cover.
zig_test(
    name = "zig_cover_exe_test",
    exec_compatible_with = LINUX_X86_64,
    env_tools = {
        "KCOV": ":kcov",
        "NORMALIZE": ":cov_normalize_exe",
        "PINNED_ZIG": _ZIG,
        "PINNED_ZIG_012": "buildrules//rules/pins:zig",
        "ZIG_COVER": ":zig_cover_exe",
    },
    imports = [
        "tools/fixtures/zig_cover/fail_test.zig",
        "tools/fixtures/zig_cover/leak_test.zig",
        "tools/fixtures/zig_cover/log_test.zig",
        "tools/fixtures/zig_cover/mini.zig",
        "tools/fixtures/zig_cover/mini_test.zig",
        "tools/fixtures/zig_cover/wrap_test.zig",
        "tools/zig_cov_runner.zig",
    ],
    src = "tools/zig_cover_exe_test.zig",
    busybox = _BB,
    zig = _ZIG,
)

cov_tool(
    name = "zig_cover",
    cases = [":zig_cover_exe_test"],
    exec_compatible_with = LINUX_X86_64,
    exe = ":zig_cover_exe",
    visibility = ["PUBLIC"],
)

