# Read by the buildrules.dev site tests (site/BUCK), which check its pages against this file.
export_file(
    name = "pins.bzl",
    src = "pins.bzl",
    visibility = ["//site:", "//ci:"],
)

# The coverage of the sources the unit tests compile (README.md, "Zig coverage"), and the floor it is held to. The process tests (`*_exe_test`) run the
# built executables and add nothing to it; conda_payload.zig and elf_rpath.zig have no unit test, cov_zig_stub.zig is a stand-in program, and
# zig_cov_runner.zig is compiled into every test it measures, so none of them is measured.
zig_coverage(
    test_targets = [
        ":debug_relocate_unit",
        ":cov_normalize_unit",
        ":cov_zig_unit",
        ":cov_run_unit",
        ":cov_summary_unit",
        ":kcov_build_unit",
        ":zig_cover_unit",
        ":cov_floor_unit",
    ],
    expect = ["rules/coverage/tools/" + f for f in [
        "debug_relocate.zig",
        "cov_normalize.zig",
        "cov_zig.zig",
        "cov_zig_elf.zig",
        "cov_run.zig",
        "cov_summary.zig",
        "kcov_build.zig",
        "zig_cover.zig",
        "cov_floor.zig",
    ]],
)

scrub_files()
