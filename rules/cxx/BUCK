load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The C/C++ family: the toolchain's launcher, and the symbol-prefixing tools (README.md).
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("//rules/core:platform.bzl", "LINUX_X86_64")
load("//rules/zig:zig.bzl", "zig_exe", "zig_module", "zig_test")
load(":defs.bzl", "c_exe")

# zig_cc_launcher: runs `zig cc|c++|ar|ranlib` for the toolchain (toolchain.bzl): expands the nested response
# files the prelude passes (zig refuses them) and gives zig a cache directory under the working directory.
# Built by the pinned zig 0.12, as the Rust rules' link steps are.
# The unit tests of asm_split (asm_split_test.zig).
zig_test(
    name = "asm_split_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "asm_split_test.zig",
    imports = ["asm_split.zig"],
    zig = "buildrules//rules/pins:zig",
)

# asm_split (Zig): the text step of native_library's `asm_split` (rules/native/asm_split.bzl): runs the preprocessor and writes its output with every `;` a line break.
zig_exe(
    name = "asm_split",
    exec_compatible_with = LINUX_X86_64,
    src = "asm_split.zig",
    unit_tests = [":asm_split_unit"],
    zig = "buildrules//rules/pins:zig",
    visibility = ["PUBLIC"],
)

zig_exe(
    name = "zig_cc_launcher",
    exec_compatible_with = LINUX_X86_64,
    src = "zig_cc_launcher.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig",
    visibility = ["PUBLIC"],
)

# zig 0.15.2 builds the prefix tool; it is built behind the check that the pin is that release.
_ZIG = "buildrules//rules/pins:zig_next"
_ZIG_VERSION = "buildrules//rules/pins:zig_next_version"

# elfsyms: an archive's symbol table and its members' symbols (prefix/elfsyms.c). The C toolchain has no `nm`.
c_exe(
    name = "elfsyms",
    exec_compatible_with = LINUX_X86_64,
    src = "prefix/elfsyms.c",
    visibility = ["PUBLIC"],
)

_SRCS = glob(["prefix/src/*.zig"])

# The unit tests of prefix_tool: `zig test` of main.zig, whose test block imports prefix_test.zig and
# cli_test.zig, run as a build action. cli_test.zig runs the commands in-process over archives it writes, with the
# real elfsyms (ELFSYMS), so the command code is measured by the coverage run, which counts only the test's own process.
zig_test(
    name = "prefix_tool_unit",
    env_tools = {"ELFSYMS": ":elfsyms"},
    exec_compatible_with = LINUX_X86_64,
    imports = _SRCS,
    deps = [":cxx_builtins"],
    src = "prefix/src/main.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = _ZIG,
)

# prefix_tool (Zig): `header` writes a prefix_header's header, `check` is a prefixed_archive_check. Built
# behind its unit tests: no header or check runs unless they pass.
zig_exe(
    name = "prefix_tool",
    exec_compatible_with = LINUX_X86_64,
    imports = _SRCS,
    deps = [":cxx_builtins"],
    src = "prefix/src/main.zig",
    unit_tests = [":prefix_tool_unit", _ZIG_VERSION],
    busybox = "buildrules//rules/pins:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# glibc_floor (Zig): the newest glibc symbol version an ELF needs; `glibc_floor_check` (defs.bzl) fails a build
# whose binary needs more than the toolchain's floor. Behind its unit tests (floor/src/floor_test.zig).
zig_test(
    name = "glibc_floor_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["floor/src/floor_test.zig"],
    src = "floor/src/floor.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = _ZIG,
)

zig_exe(
    name = "glibc_floor",
    exec_compatible_with = LINUX_X86_64,
    imports = ["floor/src/floor_test.zig"],
    src = "floor/src/floor.zig",
    unit_tests = [":glibc_floor_unit", _ZIG_VERSION],
    busybox = "buildrules//rules/pins:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# hermetic (Zig): an ELF built by the C/C++ toolchain has no `.debug_*` section and does not contain the path of the directory it was linked in;
# `hermetic_check` (defs.bzl) is the validation. Behind its unit tests (hermetic/src/hermetic_test.zig).
zig_test(
    name = "hermetic_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["hermetic/src/hermetic_test.zig"],
    src = "hermetic/src/hermetic.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = _ZIG,
)

zig_exe(
    name = "hermetic",
    exec_compatible_with = LINUX_X86_64,
    imports = ["hermetic/src/hermetic_test.zig"],
    src = "hermetic/src/hermetic.zig",
    unit_tests = [":hermetic_unit", _ZIG_VERSION],
    busybox = "buildrules//rules/pins:busybox",
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# The compiler builtins a library may define itself (builtins/src/builtins.zig): one list for prefix_tool and archive_check.
zig_test(
    name = "builtins_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = ["builtins/src/builtins_test.zig"],
    src = "builtins/src/builtins.zig",
    zig = _ZIG,
)

zig_module(
    name = "cxx_builtins",
    src = "builtins/src/builtins.zig",
    imports = ["builtins/src/builtins_test.zig"],
    unit_tests = [":builtins_unit"],
)

# The checks above as modules, so the archive check applies the same code to each member of a native library.
zig_module(
    name = "cxx_hermetic",
    src = "hermetic/src/hermetic.zig",
    imports = ["hermetic/src/hermetic_test.zig"],
    unit_tests = [":hermetic_unit"],
)

zig_module(
    name = "cxx_floor",
    src = "floor/src/floor.zig",
    imports = ["floor/src/floor_test.zig"],
    unit_tests = [":glibc_floor_unit"],
)

# archive_check (Zig): the validation of a native static library (`native_archive`, native.bzl): deterministic members, no debug section, no
# build path, the glibc floor, and no undefined symbol that the final link would lack. Behind its unit tests (archive/src/archive_test.zig).
_ARCHIVE_SRCS = ["archive/src/archive_test.zig", "archive/src/archive_macho_test.zig", "archive/src/floor_symbols.txt", "archive/src/floor_symbols_macos.txt"]

zig_test(
    name = "archive_check_unit",
    exec_compatible_with = LINUX_X86_64,
    imports = _ARCHIVE_SRCS,
    src = "archive/src/archive.zig",
    deps = [":cxx_hermetic", ":cxx_floor", ":cxx_builtins"],
    zig = _ZIG,
)

zig_exe(
    name = "archive_check",
    exec_compatible_with = LINUX_X86_64,
    imports = _ARCHIVE_SRCS,
    src = "archive/src/archive.zig",
    deps = [":cxx_hermetic", ":cxx_floor", ":cxx_builtins"],
    unit_tests = [":archive_check_unit", _ZIG_VERSION],
    zig = _ZIG,
    visibility = ["PUBLIC"],
)

# Read by the buildrules.dev site's tests (site/BUCK), which check its pages against this file.
export_file(
    name = "defs.bzl",
    src = "defs.bzl",
    visibility = ["//site:"],
)

# Read by the buildrules.dev site's tests (site/BUCK).
export_file(
    name = "archive.bzl",
    src = "archive.bzl",
    visibility = ["//site:"],
)

# Read by the buildrules.dev site tests (site/BUCK), which check its pages against this file.
export_file(
    name = "toolchain.bzl",
    src = "toolchain.bzl",
    visibility = ["//site:"],
)

# The coverage of the sources the tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to. zig_cc_launcher.zig and
# elfsyms.c have no unit test and are not measured.
zig_coverage(
    test_targets = [":prefix_tool_unit", ":glibc_floor_unit", ":hermetic_unit", ":archive_check_unit", ":builtins_unit"],
    expect = ["rules/cxx/" + f for f in glob(["prefix/src/*.zig", "floor/src/*.zig", "hermetic/src/*.zig", "archive/src/*.zig", "builtins/src/*.zig"], exclude = ["**/*_test.zig"])],
)

scrub_files()
