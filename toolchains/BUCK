load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules:isa.bzl", "zig_cpu")
load("@buildrules//rules/cxx:toolchain.bzl", "cxx_toolchains")
load("@buildrules//rules/mojo:toolchain.bzl", "mojo_toolchains")
load("@buildrules//rules/mopm:toolchain.bzl", "mopm_toolchains")
load("@buildrules//rules/rust:toolchain.bzl", "rust_toolchains")
load(":mojo_pins.bzl", "MOJO_TOOLCHAINS")
load(":mopm_pins.bzl", "EXTRA_MOPM_VERSIONS")
load(":rust_pins.bzl", "EXTRA_RUST_VERSIONS")

# One call each. A consumer repository's toolchains/BUCK is this file.
# Every Rust version buildrules pins, plus the ones buildrules-pins.toml adds (rust_pins.bzl, written by `buildrules sync`).
rust_toolchains(extra = EXTRA_RUST_VERSIONS)

# The C/C++ toolchain of the prelude's cxx_library and cxx_binary: pinned zig, no host compiler.
# `zig cc -mcpu` follows the target platform's ISA level (rules/isa.bzl); no level = the x86-64 baseline.
cxx_toolchains(target_cpu = zig_cpu())

# The pinned mopm (rules/mopm/pins.bzl plus buildrules-pins.toml's [mopm."V"] tables in mopm_pins.bzl), and the Mojo
# toolchains mopm's unit graphs name (mojo_pins.bzl, written by `buildrules mojo sync`): buildrules pins no Mojo itself.
mopm_toolchains(extra = EXTRA_MOPM_VERSIONS)

mojo_toolchains(MOJO_TOOLCHAINS)

scrub_files()
