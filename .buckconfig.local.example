# Copy to .buckconfig.local (gitignored). Without a [buck2_re_client] endpoint no action
# can run: the execution platform is remote unless you opt in to running on this machine
# (docs/contract.md, section 14):
#
#   [buildrules_re]
#     mode = local
#
# (and then no endpoint or property set may be configured).
[buck2_re_client]
  # engine_address = grpc://re.example.invalid:8980
  # action_cache_address = grpc://re.example.invalid:8980
  # cas_address = grpc://re.example.invalid:8980
  # instance_name = main
  # tls = true

[buildrules_re]
  # The exact REAPI property set of linux-x86_64 workers (key=value, comma separated).
  # linux_x86_64_properties = OSFamily=Linux,ISA=x86-64,container-image=docker://<image>@sha256:<digest>
  # Optional, for Mojo packages built for linux aarch64 / macOS arm64 (docs/contract.md, section 14):
  # linux_aarch64_properties = <the exact property set of your linux aarch64 workers>
  # macos_aarch64_properties = <the exact property set of your macOS arm64 workers>
  # With macos_aarch64_properties: the host identities of those workers, separated by spaces (what `mojo_compile host-identity` prints on each). A macOS compile
  # runs on a listed host only, and the list is part of its action key.
  # darwin_macos_hosts = <identity> <identity>
  # Linux arm64 tests are off (default) until Linux arm64 farm hardware is racked: the linux aarch64 platform is not registered and Mojo targets for linux aarch64 are
  # skipped ("skipped: waiting on linux-arm64 hardware"), whatever linux_aarch64_properties says. Re-enable with this one line:
  # linux_arm64_enabled = true
