load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The buildrules command line, in Zig, built by the pinned zig behind its unit tests.
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_exe_target_test", "zig_module", "zig_test")
load(":release.bzl", "release_binaries")
load(":version.bzl", "cli_version", "version_stamp")
load(":version_cases.bzl", "stamps")
load("@buildrules//rules/rust:refusal.bzl", "accepts", "refuses")
load("@buildrules//rules:matrix.bzl", "group")
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")

# The CLI is Zig 0.15 code (std.Io, ArrayList.empty): it builds with the pinned zig_next, as kpin does.
_ZIG = "buildrules//rules/pins:zig_next"

_SRCS = glob(["src/*.zig", "src/fixture/*"])

# The version `buildrules --version` prints (the module `buildrules_version`, imported by main.zig). The release workflow builds with
# `-c buildrules.release_version=<the planned version>`; any other build reports the VERSION file's MAJOR.MINOR with `-dev` (cli/version.bzl).
cli_version(
    name = "version_zig",
    file = "//:VERSION",
    release = read_config("buildrules", "release_version", ""),
)

zig_module(
    name = "buildrules_version",
    src = ":version_zig",
)

# The bytes of version.zig for a VERSION file (cli/version.bzl `version_stamp`), pinned as analysis tests (rules/rust/refusal.bzl): what the sed this replaced
# accepted gives its exact bytes (a final newline or none, a lone matching line among others), and what it could not turn into a compiling program is refused.
# The stamp is also held end to end by :version_unit below, on the real VERSION file.
_DEV = 'pub const release = "1.2-dev";\n'

_STAMPS = [
    accepts("stamp_plain_line", stamps, ["1.2\n", _DEV]),
    accepts("stamp_no_final_newline", stamps, ["1.2", _DEV]),
    accepts("stamp_many_digits", stamps, ["10.250\n", 'pub const release = "10.250-dev";\n']),
    accepts("stamp_leading_zeros_kept", stamps, ["0.0\n", 'pub const release = "0.0-dev";\n']),
    accepts("stamp_one_line_among_others", stamps, ["# the version\n\n1.2\nnotes\n", _DEV]),
    accepts("stamp_blank_lines_around", stamps, ["\n1.2\n\n\n", _DEV]),
    refuses("stamp_empty_file", version_stamp, ["", "//cli:version_zig"], ["//cli:version_zig", "exactly one line", "found 0"]),
    refuses("stamp_three_parts", version_stamp, ["1.2.3\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_not_a_number", version_stamp, ["abc\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_missing_minor", version_stamp, ["1\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_empty_part", version_stamp, [".2\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_trailing_dot", version_stamp, ["1.\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_trailing_space", version_stamp, ["1.2 \n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_leading_space", version_stamp, [" 1.2\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_carriage_return", version_stamp, ["1.2\r\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_sign", version_stamp, ["-1.2\n", "//cli:version_zig"], ["found 0"]),
    refuses("stamp_two_version_lines", version_stamp, ["1.2\n3.4\n", "//cli:version_zig"], ["found 2"]),
]

group(name = "version_stamps", deps = _STAMPS, visibility = ["PUBLIC"])

_TESTS = [
    "autopin_api",
    "autopin_check",
    "autopin_compute",
    "autopin_gh",
    "autopin_http",
    "autopin_inflate",
    "autopin_manifest",
    "autopin_oom",
    "autopin_push",
    "autopin_safe",
    "autopin_verify",
    "autopin_table",
    "autopin_zip",
    "cargo_cmd",
    "buckgen",
    "contract",
    "ctx",
    "fetch",
    "growth",
    "init",
    "lockreaders",
    "failclosed",
    "mojo_cmd",
    "mojo_lock",
    "mopm_pins",
    "pins_toml",
    "npm_cmd",
    "sync_check",
    "toml",
    "unitgen",
    "val",
    "valid",
]

[
    zig_test(
        name = name + "_unit",
        src = "src/" + name + "_test.zig",
        imports = _SRCS,
        deps = [":buildrules_version"],
        zig = _ZIG,
    )
    for name in _TESTS
]

# All of the above in one program: the coverage of the package is measured on it (see src/all_test.zig for why one program).
zig_test(
    name = "all_unit",
    src = "src/all_test.zig",
    imports = _SRCS,
    deps = [":buildrules_version"],
    zig = _ZIG,
)

# What the stamp is: `--version` prints it, and it is the VERSION file's MAJOR.MINOR with `-dev`, or a release number of that MAJOR.MINOR
# (a build with -c buildrules.release_version=...). The VERSION file is the test's data.
zig_test(
    name = "version_unit",
    src = "src/version_test.zig",
    imports = _SRCS,
    deps = [":buildrules_version"],
    data = {"VERSION": "//:VERSION"},
    zig = _ZIG,
)

# The coverage of the sources the unit tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to. The tests of
# the files themselves and the shared test kit are not counted, nor is contract.zig, which holds constants and no code.
zig_coverage(
    test_targets = [":all_unit", ":version_unit"],
    expect = ["cli/" + f for f in glob(["src/*.zig"], exclude = ["src/*_test.zig", "src/testkit.zig", "src/contract.zig"])],
)

zig_exe(
    name = "buildrules",
    src = "src/main.zig",
    imports = _SRCS,
    deps = [":buildrules_version"],
    zig = _ZIG,
    unit_tests = [":" + name + "_unit" for name in _TESTS] + [":version_unit"],
    visibility = ["PUBLIC"],
)

# Read by the buildrules.dev site's tests (site/BUCK), which check its pages against this file.
export_file(
    name = "main.zig",
    src = "src/main.zig",
    visibility = ["//site:"],
)

# The binaries of a release (RELEASING.md): the same program built for the three release targets. Each is a zig_exe of the same source and tests; only `target`
# differs. They are built on the linux execution platform (zig cross-compiles a program that needs no SDK). An asset is named for the release target
# (`linux-x86_64`...); the zig triple of each is written out twice on purpose: here, and again as the `expect` of its zig_exe_target_test below, so a
# change to one alone is red.
_CROSS = {
    "linux-x86_64": "x86_64-linux-musl",
    "linux-aarch64": "aarch64-linux-musl",
    "macos-arm64": "aarch64-macos",
}

[
    zig_exe(
        name = "buildrules_" + name.replace("-", "_"),
        src = "src/main.zig",
        imports = _SRCS,
        deps = [":buildrules_version"],
        zig = _ZIG,
        target = triple,
        unit_tests = [":" + test + "_unit" for test in _TESTS] + [":version_unit"],
        visibility = ["PUBLIC"],
    )
    for name, triple in _CROSS.items()
]

zig_exe_target_test(name = "linux_x86_64_is_x86_64_linux_musl", exe = ":buildrules_linux_x86_64", expect = "x86_64-linux-musl", same_tests_as = ":buildrules", visibility = ["PUBLIC"])

zig_exe_target_test(name = "linux_aarch64_is_aarch64_linux_musl", exe = ":buildrules_linux_aarch64", expect = "aarch64-linux-musl", same_tests_as = ":buildrules", visibility = ["PUBLIC"])

zig_exe_target_test(name = "macos_arm64_is_aarch64_macos", exe = ":buildrules_macos_arm64", expect = "aarch64-macos", same_tests_as = ":buildrules", visibility = ["PUBLIC"])

# The three in one directory, `<release target>/buildrules` for each: what the release workflow builds with one command, packages and ships (cli/release.bzl).
release_binaries(
    name = "release_binaries",
    binaries = {name: ":buildrules_" + name.replace("-", "_") for name in _CROSS},
    visibility = ["PUBLIC"],
)

# The bytes of the three: ELF machine or Mach-O cputype, from the files (header_test.zig), the directory `release_binaries` puts each at the path of its target, and the
# version the program says, as a string of its own in each file (the check `release package` makes of a binary it cannot run).
zig_test(
    name = "header_unit",
    src = "header_test.zig",
    deps = ["//tools/release:binhdr"],
    data = dict({name: ":buildrules_" + name.replace("-", "_") for name in _CROSS}, **{"VERSION": "//:VERSION", "release_binaries": ":release_binaries"}),
    zig = _ZIG,
    visibility = ["PUBLIC"],
)


