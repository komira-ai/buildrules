load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("//rules:isa.bzl", "ISA_LEVELS", "exec_levels")
load("//rules/rust:pins.bzl", "RUST_VERSIONS", "vname")

# One platform, linux x86_64, per ISA level and per Rust version (below).
constraint_setting(name = "os", visibility = ["PUBLIC"])
constraint_setting(name = "cpu", visibility = ["PUBLIC"])
constraint_value(name = "linux", constraint_setting = ":os", visibility = ["PUBLIC"])
constraint_value(name = "macos", constraint_setting = ":os", visibility = ["PUBLIC"])
constraint_value(name = "x86_64", constraint_setting = ":cpu", visibility = ["PUBLIC"])
constraint_value(name = "aarch64", constraint_setting = ":cpu", visibility = ["PUBLIC"])

# The target platform of everything (`[parser]` in .buckconfig) and the
# configuration of the execution platform, so a tool built to run in an action is
# configured exactly like a target built for that platform.
platform(
    name = "linux_x86_64",
    constraint_values = [":linux", ":x86_64"],
    visibility = ["PUBLIC"],
)

# The other hosts (rules/pins/hosts.bzl): a runner that is linux aarch64 or macOS on Apple silicon. These are the configuration of the
# execution platform that `[buildrules_re] mode = local` registers on such a machine (rules/platforms.bzl), and a target platform for the
# pins that exist for them. A farm that has workers of such a kind registers the platform with `[buildrules_re] linux_aarch64_properties` / `macos_aarch64_properties`
# (rules/platforms.bzl); the Mojo rules run on the platform of their target platform's kind (rules/mojo/exec.bzl), every other rule on linux x86_64.
platform(
    name = "linux_aarch64",
    constraint_values = [":linux", ":aarch64"],
    visibility = ["PUBLIC"],
)

platform(
    name = "macos_aarch64",
    constraint_values = [":macos", ":aarch64"],
    visibility = ["PUBLIC"],
)

# The OS and the CPU of a target platform are read in two vocabularies: this package's own constraint values (`:linux`, `:aarch64`, ...), and the prelude's
# (`prelude//os/constraints:linux`, `prelude//cpu/constraints:arm64`, ...), which a repository that does not know buildrules puts on its platforms. Each
# (OS, CPU) pair therefore has three config settings, and every `select` that chooses by the host lists all three with the same value (rules/core/platform.bzl,
# `by_os_cpu`):
#
#   is_<os>_<cpu>          this package's two values
#   is_prelude_<os>_<cpu>  the prelude's two values
#   is_both_<os>_<cpu>     all four: a platform that carries both vocabularies matches the three, and this one is the more specific, so Buck2 does not see an
#                          ambiguous `select`.
#
# A platform that carries neither vocabulary (or one value of one and one of the other) matches none and takes the `DEFAULT`. An ISA-level platform
# (linux_x86_64_v3, ...) is linux x86_64 and matches too.
_PRELUDE_OS = {"linux": "prelude//os/constraints:linux", "macos": "prelude//os/constraints:macos"}
_PRELUDE_CPU = {"x86_64": "prelude//cpu/constraints:x86_64", "aarch64": "prelude//cpu/constraints:arm64"}

[
    [
        config_setting(name = "is_" + os + "_" + cpu, constraint_values = [":" + os, ":" + cpu], visibility = ["PUBLIC"]),
        config_setting(name = "is_prelude_" + os + "_" + cpu, constraint_values = [_PRELUDE_OS[os], _PRELUDE_CPU[cpu]], visibility = ["PUBLIC"]),
        config_setting(name = "is_both_" + os + "_" + cpu, constraint_values = [":" + os, ":" + cpu, _PRELUDE_OS[os], _PRELUDE_CPU[cpu]], visibility = ["PUBLIC"]),
    ]
    for os, cpu in [("linux", "x86_64"), ("linux", "aarch64"), ("macos", "aarch64")]
]

# macOS on Intel: no subdir of mopm's has a unit graph for it, so a Mojo package built for it is refused at analysis (ci/negative).
platform(
    name = "macos_x86_64",
    constraint_values = [":macos", ":x86_64"],
    visibility = ["PUBLIC"],
)

# No platform has this value: a target that requires it is skipped by a wildcard build (`:coverage` until it exists).
constraint_setting(name = "implementation", visibility = ["PUBLIC"])
constraint_value(name = "not_implemented", constraint_setting = ":implementation", visibility = ["PUBLIC"])

# Linux arm64 tests are off until Linux arm64 farm hardware is racked (`[buildrules_re] linux_arm64_enabled`, rules/platforms.bzl). While it is off every Mojo target
# requires this value on a linux aarch64 target platform. No platform has it, so such a target is incompatible: `buck2 build --skip-incompatible-targets` lists it as
# skipped, naming this constraint ("skipped: waiting on linux-arm64 hardware"), and builds nothing for it.
constraint_setting(name = "linux_arm64_hardware", visibility = ["PUBLIC"])
constraint_value(name = "skipped_waiting_on_linux_arm64_hardware", constraint_setting = ":linux_arm64_hardware", visibility = ["PUBLIC"])

# ---- ISA levels (rules/isa.bzl) -----------------------------------------------------------------
# `isa_level` is a TARGET constraint. No value = no flag (today's action keys). A target platform adds one value;
# `linux_x86_64_v3` is linux_x86_64 plus `isa_x86_64_v3`. The cpu value of each platform is its level's family, so an x86 level never meets an aarch64 cpu.
constraint_setting(name = "isa_level", visibility = ["PUBLIC"])

# `exec_isa` is an EXECUTION constraint: only the execution platforms of platforms/exec carry it. A test that needs
# level vN lists `exec_isa_x86_64_vN` in `exec_compatible_with`, so Buck2 puts its run action on that platform and the farm
# reports `ISA=x86-64-vN`. The compile actions never list it.
constraint_setting(name = "exec_isa", visibility = ["PUBLIC"])

[
    [
        constraint_value(name = "isa_" + v["id"], constraint_setting = ":isa_level", visibility = ["PUBLIC"]),
        config_setting(name = "isa_is_" + v["id"], constraint_values = [":isa_" + v["id"]], visibility = ["PUBLIC"]),
        constraint_value(name = "exec_isa_" + v["id"], constraint_setting = ":exec_isa", visibility = ["PUBLIC"]),
        config_setting(name = "exec_isa_is_" + v["id"], constraint_values = [":exec_isa_" + v["id"]], visibility = ["PUBLIC"]),
    ]
    for v in ISA_LEVELS.values()
]

# An Arm level is also linux aarch64: the key of the `select` of a test's execution platform that is the more specific for a platform at that level (rules/mojo/exec.bzl).
# One per vocabulary and one for both, as `is_linux_aarch64` has, so that each is the more specific than the `is_*linux_aarch64` it refines.
[
    [
        config_setting(
            name = "linux_aarch64_isa_is_" + v["id"],
            constraint_values = [":linux", ":aarch64", ":isa_" + v["id"]],
            visibility = ["PUBLIC"],
        ),
        config_setting(
            name = "prelude_linux_aarch64_isa_is_" + v["id"],
            constraint_values = [_PRELUDE_OS["linux"], _PRELUDE_CPU["aarch64"], ":isa_" + v["id"]],
            visibility = ["PUBLIC"],
        ),
        config_setting(
            name = "both_linux_aarch64_isa_is_" + v["id"],
            constraint_values = [":linux", ":aarch64", _PRELUDE_OS["linux"], _PRELUDE_CPU["aarch64"], ":isa_" + v["id"]],
            visibility = ["PUBLIC"],
        ),
    ]
    for v in ISA_LEVELS.values()
    if v["family"] == "aarch64"
]

[
    platform(
        name = "linux_" + v["id"],
        constraint_values = [":linux", ":" + v["family"], ":isa_" + v["id"]],
        visibility = ["PUBLIC"],
    )
    for v in ISA_LEVELS.values()
]

# The execution platforms of the levels that have a worker (platforms/exec registers them).
[
    platform(
        name = "exec_" + ISA_LEVELS[l]["id"],
        constraint_values = [":linux", ":x86_64", ":exec_isa_" + ISA_LEVELS[l]["id"]],
        visibility = ["PUBLIC"],
    )
    for l in exec_levels()
]

# ---- Rust versions (rules/rust/pins.bzl) --------------------------------------------------------
# `buck2 build --target-platforms buildrules//platforms:linux_x86_64_rust_1_85_0 ...` compiles with that version
# (rules/rust/select.bzl): the CI matrix.
constraint_setting(name = "rust_version", visibility = ["PUBLIC"])

[
    [
        constraint_value(name = "rust_" + vname(v), constraint_setting = ":rust_version", visibility = ["PUBLIC"]),
        config_setting(name = "rust_is_" + vname(v), constraint_values = [":rust_" + vname(v)], visibility = ["PUBLIC"]),
        platform(
            name = "linux_x86_64_rust_" + vname(v),
            constraint_values = [":linux", ":x86_64", ":rust_" + vname(v)],
            visibility = ["PUBLIC"],
        ),
    ]
    for v in RUST_VERSIONS
]

scrub_files()
