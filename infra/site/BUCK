load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# The checks of the buildrules.dev hosting stack, run on the farm from the pinned npm packages
# (pins.lock.bzl, from package-lock.json by kpin) with buildrules' node rules: `npm run typecheck`
# and `npm test`. No install, no script, no network, no AWS. Nothing here deploys: the held steps
# (held/, README.md) are run by a person with their own credentials.

load("@buildrules//rules/node:modules.bzl", "jest_test", "npm_modules", "tsc_check")
load("@buildrules//rules/coverage:jest_cover.bzl", "jest_coverage_floor")
load(":pins.lock.bzl", "NPM")

_SRCS = glob(["bin/**", "held/**", "lib/**", "test/**"]) + [
    "cdk.json",
    "jest.config.js",
    "package.json",
    "tsconfig.json",
]

npm_modules(
    name = "modules",
    lockfile = "package-lock.json",
    npm = NPM,
)

tsc_check(
    name = "typecheck",
    visibility = ["//ci:"],
    modules = ":modules",
    srcs = _SRCS,
)

jest_test(
    name = "test",
    coverage = True,
    visibility = ["//ci:"],
    modules = ":modules",
    srcs = _SRCS,
)

# The lines and branches of lib/ and bin/ that the tests reach (jest --coverage), held to coverage_floor.txt.
jest_coverage_floor()

scrub_files(extra = [".gitignore"])
