# The automatic release's tool (RELEASING.md): the version of a green main commit, the deterministic source archive of a tag, the checks before
# it is published, and the release. Zig, tested as a build action; `.github/workflows/release.yml` runs it with `buck2 run`, and
# `//ci:workflow` checks that workflow.
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_module", "zig_test")
load("@buildrules//tools/scrub:defs.bzl", "scrub_files")

_SRCS = [
    "version.zig",
    "gz.zig",
    "tar.zig",
    "assets.zig",
    "page.zig",
    "cmds.zig",
    "bump.zig",
    "bump_test.zig",
    "binaries.zig",
    "release.zig",
]

# Every rule of the version scheme, the gzip (decoded by the standard library, and a pinned digest), the tar reader, the SHA256SUMS and
# release-asset rules, and each step against a fake `git` and `gh`: the tests plant a defect for every check the steps make.
# Read by the buildrules.dev site tests (site/BUCK), which check the Releases section against these.
export_file(
    name = "cmds.zig",
    src = "cmds.zig",
    visibility = ["//site:"],
)

export_file(
    name = "version.zig",
    src = "version.zig",
    visibility = ["//site:"],
)

export_file(
    name = "page.zig",
    src = "page.zig",
    visibility = ["//site:"],
)

export_file(
    name = "binhdr.zig",
    src = "binhdr.zig",
    visibility = ["//site:"],
)

# What a release binary's file header must say for its target (an ELF of the right machine, static; a Mach-O of the right cpu). `release package` refuses a
# binary that is not its target's, and cli/header_test.zig checks the three built binaries with it. Importers wait for its tests.
zig_test(
    name = "binhdr_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "binhdr.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

zig_module(
    name = "binhdr",
    src = "binhdr.zig",
    unit_tests = [":binhdr_unit"],
    visibility = ["PUBLIC"],
)

zig_test(
    name = "release_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "release_test.zig",
    imports = _SRCS,
    deps = ["//tools/scrub:scrub_lib", ":binhdr"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

zig_exe(
    name = "release",
    exec_compatible_with = LINUX_X86_64,
    src = "release.zig",
    imports = ["version.zig", "gz.zig", "tar.zig", "assets.zig", "page.zig", "cmds.zig", "bump.zig", "binaries.zig"],
    deps = ["//tools/scrub:scrub_lib", ":binhdr"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":release_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

# The coverage of the sources the tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to.
zig_coverage(
    test_targets = [":release_unit", ":binhdr_unit"],
    expect = ["tools/release/" + f for f in glob(["*.zig"], exclude = ["*_test.zig"])],
)

scrub_files()
