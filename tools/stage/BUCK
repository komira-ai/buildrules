# The beta and gamma stages of the automatic release (RELEASING.md): a hello-world repository per language that consumes the candidate as a user
# would (beta/, run here from the STEPS file of each), and our own repositories built with the candidate on the farm (gamma). Zig, tested as a build
# action; `.github/workflows/beta.yml` and `release.yml` run it from the artifact their tool job builds.
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage")
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_exe_target_test", "zig_module", "zig_test")
load("@buildrules//tools/scrub:defs.bzl", "scrub_files")

_SRCS = [
    "steps.zig",
    "farm.zig",
    "io.zig",
    "beta.zig",
    "gamma.zig",
    "native.zig",
    "stage.zig",
]

# Every rule of the STEPS format, the copy of a beta repository, the hashing of an output, the build-twice determinism check (with a planted
# difference), the farm's `local: 0`, the pin of the candidate, and each failure, against a fake that writes the files a build would.
zig_test(
    name = "stage_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "stage_test.zig",
    imports = _SRCS,
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

# The STEPS format as a module, for //beta:beta_check, which holds every beta/<lang>/STEPS to it.
zig_module(
    name = "stage_steps",
    src = "steps.zig",
    visibility = ["//beta:"],
)

zig_exe(
    name = "stage",
    exec_compatible_with = LINUX_X86_64,
    src = "stage.zig",
    imports = [
        "steps.zig",
        "farm.zig",
        "io.zig",
        "beta.zig",
        "gamma.zig",
        "native.zig",
    ],
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":stage_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

# The same program for the hosts the beta's native legs run on (beta.yml, `beta_arm` and `beta_macos`; tools/stage/native.zig). They are built on the linux
# x86_64 execution platform, as the command line is (cli/BUCK): zig cross-compiles a program that needs no SDK. Only `target` differs, and the
# same tests gate each.
_NATIVE = {
    "linux_aarch64": "aarch64-linux-musl",
    "macos_arm64": "aarch64-macos",
}

[
    zig_exe(
        name = "stage_" + name,
        exec_compatible_with = LINUX_X86_64,
        src = "stage.zig",
        imports = [
            "steps.zig",
            "farm.zig",
            "io.zig",
            "beta.zig",
            "gamma.zig",
            "native.zig",
        ],
        zig = "buildrules//rules/pins:zig_next",
        target = triple,
        unit_tests = [":stage_unit", "buildrules//rules/pins:zig_next_version"],
        visibility = ["PUBLIC"],
    )
    for name, triple in _NATIVE.items()
]

zig_exe_target_test(name = "linux_aarch64_is_aarch64_linux_musl", exe = ":stage_linux_aarch64", expect = "aarch64-linux-musl", same_tests_as = ":stage", visibility = ["PUBLIC"])

zig_exe_target_test(name = "macos_arm64_is_aarch64_macos", exe = ":stage_macos_arm64", expect = "aarch64-macos", same_tests_as = ":stage", visibility = ["PUBLIC"])

# Read by the buildrules.dev site tests (site/BUCK), which check the Releases section against the stage tool's messages.
export_file(
    name = "gamma.zig",
    src = "gamma.zig",
    visibility = ["//site:"],
)

# The coverage of the sources the tests compile (rules/coverage/README.md, "Zig coverage"), and the floor it is held to.
zig_coverage(
    test_targets = [":stage_unit"],
    expect = ["tools/stage/" + f for f in glob(["*.zig"], exclude = ["*_test.zig"])],
)

scrub_files()
