# The public-repository scrub (tools/scrub/README.md): `buck2 build //tools/scrub:scrub` is red when any file of the repository holds a date before
# 2026-09-01, a person's name, an email, a home path, a private host, an IP address, an endpoint, control-plane vocabulary or the name of the
# project this one grew out of. It runs on the farm, over every package's files (`scrub_files()`, the last line of every BUCK file).
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_module", "zig_test")
load(":defs.bzl", "scrub_files", "scrub_test")

zig_test(
    name = "scrub_unit",
    exec_compatible_with = LINUX_X86_64,
    src = "scrub_test.zig",
    imports = ["scrub.zig"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
)

# The scrub as a module, for the release tool: the archive it publishes is scanned by the very rules the repository is.
zig_module(
    name = "scrub_lib",
    src = "scrub.zig",
    unit_tests = [":scrub_unit"],
    visibility = ["PUBLIC"],
)

zig_exe(
    name = "scrub_exe",
    exec_compatible_with = LINUX_X86_64,
    src = "scrub.zig",
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    unit_tests = [":scrub_unit", "buildrules//rules/pins:zig_next_version"],
    visibility = ["PUBLIC"],
)

# A package missing its `scrub_files()` is not scanned: add the call to its BUCK file and its label here. Requiring a file of the root
# package, of a deep package and of the CLI makes an empty glob red.
scrub_test(
    name = "scrub",
    packages = [
    "//:scrub_files",
