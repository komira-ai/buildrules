load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# Kept by hand, in the unit-level form (see examples/p4ws): an integration test of a cargo package, whose run //ci:all builds. The test reads back how it was started
# (tests/env.rs): in its package directory, with CARGO_MANIFEST_DIR, TMPDIR and CARGO_TARGET_TMPDIR absolute and the last one made. They are the options of
# `check marker` that rules/rust/cargo_unit.bzl gives (`_START`); drop one and this test is red.
load("@buildrules//rules/rust:cargo_unit.bzl", "cargo_unit")

cargo_unit(
    name = "env_test",
    pkg = "cargo_run",
    version = "0.1.0",
    crate_name = "env",
    mode = "test",
    crate_type = "bin",
    side = "target",
    target_kind = "test",
    target_name = "env",
    edition = "2021",
    root = "tests/env.rs",
    crate_hash = "0123456789",
    opt_level = "0",
    debuginfo = "0",
    debug_assertions = True,
    overflow_checks = True,
    srcs = glob(["tests/**"]),
    labels = ["cargo_run"],
    visibility = ["//ci:"],
)

# The unit test of a binary target (`target_kind = "bin"`): no CARGO_TARGET_TMPDIR. The library kind is //examples/p4ws/crates/probe_ok's test.
cargo_unit(
    name = "bin_test",
    pkg = "cargo_run",
    version = "0.1.0",
    crate_name = "cargo_run",
    mode = "test",
    crate_type = "bin",
    side = "target",
    target_kind = "bin",
    target_name = "cargo_run",
    edition = "2021",
    root = "src/main.rs",
    crate_hash = "9876543210",
    opt_level = "0",
    debuginfo = "0",
    debug_assertions = True,
    overflow_checks = True,
    srcs = glob(["src/**"]),
    labels = ["cargo_run"],
    visibility = ["//ci:"],
)

scrub_files()
