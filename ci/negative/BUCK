load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules:isa.bzl", "required_isa", "test_exec_compatible_with")
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load("@buildrules//rules/zig:zig.bzl", "zig_test")
load("@buildrules//rules/rust:test_run.bzl", "test_run")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_exe_target_test")
load("@buildrules//rules/cxx:defs.bzl", "checked_cxx_library")
load("@buildrules//rules/node:defs.bzl", "npm_tarball")
load("@buildrules//rules/coverage:zig_cover.bzl", "zig_coverage_rule")
load("@buildrules//rules/mojo:unit.bzl", "mojo_cov_pgo_rule")

# The control of the bxl check (ci/negative.bzl) on the fixture below: the same run of the same test, with the one line the fixture leaves out. It must analyse, on the platform the
# fixture does not, or the fixture could be red for another reason.
test_run(
    name = "v3_test_with_isa_property",
    unit = "//examples/isa:isa_lib_test__bin",
    exec_compatible_with = test_exec_compatible_with(),
    required_isa = required_isa(),
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# The files that make the fixture a known defect, held to each other: the pair, ci/negative.bzl, the CI step (ci/completeness.bxl) and the rule's message.
# The bxl check holds the build itself; this is the part of it that //ci:all builds.
zig_test(
    name = "negative_check",
    exec_compatible_with = LINUX_X86_64,
    src = "negative_check.zig",
    data = {
        "ci/negative/BUCK": "BUCK",
        "ci/negative.bzl": "//ci:negative.bzl",
        "ci/completeness.bxl": "//ci:completeness.bxl",
        "ci/all.bzl": "//ci:all.bzl",
        "rules/rust/test_run.bzl": "//rules/rust:test_run.bzl",
    },
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["//ci:"],
)

# KNOWN DEFECTS that must stay red. Each is compatible only with the platform it breaks on, so a wildcard build of the
# repository skips it, and building it by name on that platform must FAIL while the build graph is analysed:
#
#   buck2 build --target-platforms buildrules//platforms:linux_x86_64_v3 //ci/negative:v3_test_without_isa_property
#
# It is the run of the x86-64-v3 test with `exec_compatible_with` left out: the rule would run on any worker, and the AVX2
# instruction in it would die with SIGILL on one that lacks AVX2. The rule refuses it (test_run.bzl).
#
# `buck2 bxl //ci:negative.bxl:check` (the public CI runs it as a part of `//ci:completeness.bxl:check`) analyses it on that platform and REQUIRES the
# refusal, with the reason above, and requires the control (above) to analyse. Make the fixture valid and that check is red.
test_run(
    name = "v3_test_without_isa_property",
    unit = "//examples/isa:isa_lib_test__bin",
    required_isa = required_isa(),
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# The cross-built copy of a program must wait for exactly the unit tests of the program it copies (cli/BUCK: `zig_exe_target_test(same_tests_as = ...)`).
# Faulty: `hello_zig` is for the triple it is expected to be (the triple check passes), but waits for its own tests and not for those of `//cli:buildrules`,
# so the rule must refuse, and for that reason (the message names the unit tests). Building it by name on the platform it is compatible with must FAIL
# in analysis:
#
#   buck2 build --target-platforms buildrules//platforms:linux_x86_64_v3 //ci/negative:cross_exe_with_other_tests
zig_exe_target_test(
    name = "cross_exe_with_other_tests",
    exe = "//examples/zig:hello_zig",
    expect = "x86_64-linux-musl",
    same_tests_as = "//cli:buildrules",
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# The refusals a user meets that no wildcard build shows: a dependency of the wrong kind, and coverage of nothing. Each fixture is compatible only with the platform it is
# analysed on (ci/negative.bzl), so a wildcard build skips it, and analysing it there must FAIL for the reason listed in ci/negative.bzl (`CASES`):
#
#   buck2 build --target-platforms buildrules//platforms:linux_x86_64_v3 //ci/negative:zig_exe_with_a_dep_of_the_wrong_kind
#
# `deps` of a zig_exe are zig_module targets; here it names an executable.
zig_exe(
    name = "zig_exe_with_a_dep_of_the_wrong_kind",
    src = "negative_check.zig",
    deps = ["//examples/zig:hello_zig"],
    busybox = "buildrules//rules/pins:busybox",
    zig = "buildrules//rules/pins:zig_next",
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# The `checks` of a checked_cxx_library are validations (a target that returns a ValidationInfo); here one is an executable that returns none, so nothing would run it.
checked_cxx_library(
    name = "cxx_library_gated_by_the_wrong_kind",
    lib = "//examples/cxx:hello_c",
    checks = ["//examples/zig:hello_zig"],
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# The `deps` of an npm_tarball are npm packages; here it names an executable.
npm_tarball(
    name = "npm_tarball_with_a_dep_of_the_wrong_kind",
    package = "left-pad",
    version = "1.3.0",
    integrity = "sha512-3a81oZNherrMQXNJriBBMRLm+k6JqX6iCp7u5ktV05ohkpkqJ0/BqDa6PCOj/uu9RU1EI2Q86A4qmslPpUyknw==",
    tarball = "//examples/zig:hello_zig",
    deps = ["//examples/zig:hello_zig"],
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# A coverage target with no test to measure: the rule refuses (rules/coverage/checks.bzl).
zig_coverage_rule(
    name = "zig_coverage_of_no_test",
    test_targets = [],
    expect = [],
    blocks = False,
    exec_compatible_with = LINUX_X86_64,
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

# The instrumented link of a test's branch coverage must carry every native library the test's ordinary link does, in the graph's order. These are the
# instrumented link of `sys_app`'s test (a unit that links two static archives, the first needing the second) with one library left out, and with the
# archives in the other order. Each must be refused in analysis, naming what is wrong (rules/mojo/unit.bzl, `cov_link_natives`), or the instrumented
# test would fail to link, or link in another way than the test it measures.
mojo_cov_pgo_rule(
    name = "mojo_instrumented_link_without_a_native_the_unit_links",
    bc = "//examples/mojo/sys_app:test_sys_app__bc",
    branch = "toolchains//:mojo_1_0_0_cov_branch",
    native_needs = {"libprobe_sys.a": ["libbase_sys.a"]},
    native_sonames = ["libprobe_sys.a", "libbase_sys.a"],
    natives = {"libprobe_sys.a": "//examples/mojo/sys_app:prebuilt_probe_sys[libprobe_sys.a]"},
    toolchain = "toolchains//:mojo_1_0_0",
    exec_compatible_with = LINUX_X86_64,
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

mojo_cov_pgo_rule(
    name = "mojo_instrumented_link_with_a_needed_archive_before_its_user",
    bc = "//examples/mojo/sys_app:test_sys_app__bc",
    branch = "toolchains//:mojo_1_0_0_cov_branch",
    native_needs = {"libprobe_sys.a": ["libbase_sys.a"]},
    native_sonames = ["libbase_sys.a", "libprobe_sys.a"],
    natives = {
        "libbase_sys.a": "//examples/mojo/sys_app:prebuilt_base_sys[libbase_sys.a]",
        "libprobe_sys.a": "//examples/mojo/sys_app:prebuilt_probe_sys[libprobe_sys.a]",
    },
    toolchain = "toolchains//:mojo_1_0_0",
    exec_compatible_with = LINUX_X86_64,
    target_compatible_with = ["buildrules//platforms:isa_x86_64_v3"],
)

scrub_files()
