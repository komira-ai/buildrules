# The coverage of the three workflow checks and the no-shell lint (rules/coverage/README.md, "Zig coverage"), and the floor it is held to. They are built by zig 0.12, which
# has no block counters, so the report is lines only; each file holds its tests, whose lines are counted with the rest.
zig_coverage(
    blocks = False,
    test_targets = [":workflow_check", ":release_check", ":stages_check", ":lintian_check", ":no_shell_unit"],
    expect = ["ci/workflow_check.zig", "ci/release_check.zig", "ci/stages_check.zig", "ci/lintian_check.zig", "ci/no_shell_check.zig"],
)

# The `unpack_macos` job of ci.yml (tools/bootstrap): GitHub's macos-14 runner builds the program, runs its tests and unpacks the real darwin zig tarball; ci/unpack_macos_check.zig
# holds the job's urls and digests to rules/pins/hosts.bzl and every step of it to its text, and injects a defect for each.
zig_test(
    name = "unpack_macos_check",
    exec_compatible_with = LINUX_X86_64,
    src = "unpack_macos_check.zig",
    data = {
        ".github/workflows/ci.yml": "//:ci.yml",
        "rules/pins/hosts.bzl": "//rules/pins:hosts.bzl",
        "rules/pins/bootstrap.bzl": "//rules/pins:bootstrap.bzl",
    },
    zig = "buildrules//rules/pins:zig_next",
)

# The pins of the unpack program are the programs this tree builds (tools/bootstrap:pin_check_unit): a source change without new rows, and a new release tag, is red.
group(name = "unpack_pin_check", deps = ["//tools/bootstrap:pin_check_unit"])

scrub_files()
