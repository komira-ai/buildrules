# A workspace with crates.io dependencies, a build script and a native library (examples/crates, its own cell): lint and test it, and prove its
# generated files are what `buildrules sync` writes now (on the farm, against a local copy of the registry: no network).
group(name = "crates", deps = [
    "crates//:ci",
    "crates//:sync_check",
    "crates//:sync",
    "crates//:debug",
    "crates//:release",
    "crates//:lint",
    "crates//:test",
    "crates//crates/zdemo:debug",
    "crates//crates/zdemo:release",
    "crates//crates/zdemo:lib",
])

# The public CI workflow (.github/workflows/ci.yml, docs/contract.md section 14): the pinned actionlint accepts it, and ci/workflow_check.zig
# checks what actionlint does not know about this repository (actions pinned by commit, read-only token, local mode, every promised target,
# the buck2 release of tools/buck2). Each rule of the check is itself tested against faulty text.
actionlint_check(
    name = "workflow_lint",
    exec_compatible_with = LINUX_X86_64,
    actionlint = "buildrules//rules/pins:actionlint_linux_amd64.tar.gz",
    workflows = ["//:ci.yml", "//:release.yml", "//:beta.yml", "//:site.yml", "//:site-publish.yml", "//:advisories.yml", "//:lintian.yml", "//:publish-unpack.yml", "//:mopm-pin.yml", "//:apt-rotation.yml"],
)

zig_test(
    name = "workflow_check",
    exec_compatible_with = LINUX_X86_64,
    src = "workflow_check.zig",
    data = {
        ".github/workflows/ci.yml": "//:ci.yml",
        "tools/buck2": "//:buck2.pin",
        "ci/BUCK": "BUCK",
    },
)

# The release workflow (.github/workflows/release.yml, RELEASING.md): actionlint accepts it (above), and ci/release_check.zig holds it to its write
# scopes and their exact conditions, the order publish <- verify <- archive <- tag <- gamma <- beta <- gate, pinned actions and local mode. It reuses the rules of
# workflow_check.zig and injects a defect for each of its own.
zig_test(
    name = "release_check",
    exec_compatible_with = LINUX_X86_64,
    src = "release_check.zig",
    imports = ["workflow_check.zig"],
    data = {
        ".github/workflows/release.yml": "//:release.yml",
        ".github/workflows/ci.yml": "//:ci.yml",
        "tools/buck2": "//:buck2.pin",
        # the tests of workflow_check.zig, which this file imports, run here too
        "ci/BUCK": "BUCK",
    },
)

# The beta workflow (.github/workflows/beta.yml, RELEASING.md): actionlint accepts it (above), and ci/stages_check.zig holds it to its triggers, its token (the farm
# leg's `id-token` alone), the legs (the languages of beta/, the planned Mojo, arm and macos jobs, the farm job that runs only with FARM_ADDRESS), local mode, and
# the pinned farm-connect action. It reuses the rules of workflow_check.zig and the job parser of release_check.zig, and injects a defect for each of its own.
zig_test(
    name = "stages_check",
    exec_compatible_with = LINUX_X86_64,
    src = "stages_check.zig",
    imports = ["workflow_check.zig", "release_check.zig"],
    data = {
        ".github/workflows/beta.yml": "//:beta.yml",
