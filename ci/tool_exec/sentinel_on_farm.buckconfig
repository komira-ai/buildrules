# ci/tool_exec.bxl:check --state sentinel_on_farm: a farm's configuration (ci/exec_select.buckconfig's placeholders) that names the local host sentinel as a worker's
# identity, which a compile must refuse (analysis only, no endpoint).
[buildrules_re]
  mode = remote
  linux_arm64_enabled = true
  linux_x86_64_properties = OSFamily=Linux,ISA=x86-64,pool=analysis-only
  linux_aarch64_properties = OSFamily=Linux,ISA=aarch64,pool=analysis-only
  macos_aarch64_properties = OSFamily=macOS,ISA=aarch64,pool=analysis-only
  darwin_macos_hosts = local
