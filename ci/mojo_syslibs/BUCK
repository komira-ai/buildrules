load("@buildrules//ci/mojo_gate:fixture.bzl", "gate_fixture_lib")
load(":fixture.bzl", "exported_system_lib")

# The system libraries a Mojo test is given (rules/mojo/system_libs.bzl, docs/contract.md section 12.11), proven without a Mojo compiler. The two packages are the real
# conda-forge files the example package examples/mojo/load_native pins for linux-64 (libsqlite and libzlib, which it needs); `mojo_system_lib` unpacks each with
# `conda_unpack --all-libs`; `mojo_test_run_rule` runs a stand-in "test", the system probe (probe.zig), with those directories as `system_libs`. The probe passes only if
# every library file named in PROBE_NEEDS is a regular ELF file in a directory of LD_LIBRARY_PATH after the compiler's lib.
#
# green  `run_green` is given both packages and the probe needs `libsqlite3.so.0` and `libsqlite3.so` (both links of the package, written as copies) and `libz.so.1`.
#        //ci:all builds it, and it is the control of every red below.
# red    each of the others changes one thing, and its run must FAIL for the reason the probe gives. They are excluded from the wildcard build (ci/all.bzl), and
#        `buck2 bxl //ci:negative.bxl:check` builds each and requires the failure and the reason (ci/negative.bzl, `faulty_problems`):
#          run_red_no_system_libs   the run is given none: a library the worker does not have is not found (the defect a test without this wiring has)
#          run_red_one_missing      the run is given libsqlite and not libzlib: what that library needs is not found either, so every package of `loads` counts
#
# The label that adopts a package (a label that adopts a package for rules of another repository) hands a dependent the directories `:lib` exports as `MojoSystemLibsInfo`. `run_green_via_lib` is given the two
# directories a gated library with `system_libs = [":libsqlite", ":libzlib"]` lists and must find what `run_green` finds; `run_red_via_lib_without` is given the ones of a gated
# library with none, and must fail for the library it did not find (the defect a package whose `:lib` forgot its pins has).
zig_exe(
    name = "probe",
    src = "probe.zig",
    zig = "buildrules//rules/pins:zig_next",
)

probe_test(name = "probe_test", program = ":probe")

faulty_mojo_toolchain(name = "toolchain")

pinned_file(
    name = "libsqlite.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/libsqlite-3.54.1-h0737f62_101.conda",
    sha256 = "c294029f893d05286f1061bbab85b820f1eea73dd859af4bcc619197bcc34810",
    size_bytes = 980491,
)

pinned_file(
    name = "libzlib.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/libzlib-1.3.2-h25fd6f3_3.conda",
    sha256 = "eb8a0db0aa570124f7d2a93d7c7f596e3390df5e047818d873baad32985fc736",
    size_bytes = 63713,
)

mojo_system_lib_rule(
    name = "libsqlite",
    archive = ":libsqlite.conda",
    package = "libsqlite",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["//ci:"],
)

mojo_system_lib_rule(
    name = "libzlib",
    archive = ":libzlib.conda",
    package = "libzlib",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["//ci:"],
)

# Two packages with no shared library of their own (docs/contract.md section 12.11, "no package is refused for what it is"): conda-forge's `xz` is a metapackage (a
# tool and its documentation, no `lib/` file at all), and `liblzma-devel` holds the static archive and an unversioned `liblzma.so` that links to a file only the
# runtime package `liblzma` holds. The unpack gives each an empty directory and says so in a note; it is no error.
pinned_file(
    name = "xz.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/xz-5.8.3-ha02ee65_1.conda",
    sha256 = "547b2392d8f7b76efd4a0970946f6da2a1136ad5fe3dc936af81e02eb7181076",
    size_bytes = 23610,
)

pinned_file(
    name = "liblzma_devel.conda",
    url = "https://conda.anaconda.org/conda-forge/linux-64/liblzma-devel-5.8.3-hb03c661_1.conda",
    sha256 = "adef6e8b60afb684110b06b5310977c6836e1c923ce3ec199f45c0f000b42f20",
    size_bytes = 491970,
)

mojo_system_lib_rule(
    name = "xz",
    archive = ":xz.conda",
    package = "xz",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["//ci:"],
)

mojo_system_lib_rule(
    name = "liblzma_devel",
    archive = ":liblzma_devel.conda",
    package = "liblzma-devel",
    exec_compatible_with = LINUX_X86_64,
    visibility = ["//ci:"],
)

_NEEDS = {"PROBE_NEEDS": "libsqlite3.so.0,libsqlite3.so,libz.so.1"}

mojo_test_run_rule(
    name = "run_green",
    bin = ":probe_test",
    system_libs = [":libsqlite", ":libzlib"],
    test_env = _NEEDS,
    toolchain = ":toolchain",
    exec_compatible_with = test_exec_compatible_with(),
    visibility = ["//ci:"],
)

# The same run, given the two packages that hold no library as well (a lib-less root and a lib-less run dependency of a pinned set): the unpacks succeed, and the probe
# still finds every library it needs in the directories of the other two. The probe also requires every directory of the path to exist, so an unpack that wrote nothing
# at all (not even its empty directory) is red.
mojo_test_run_rule(
    name = "run_green_libless",
    bin = ":probe_test",
    system_libs = [":xz", ":libsqlite", ":liblzma_devel", ":libzlib"],
    test_env = _NEEDS,
    toolchain = ":toolchain",
    exec_compatible_with = test_exec_compatible_with(),
    visibility = ["//ci:"],
)

# Red by design: no system library, as a test run without the wiring.
mojo_test_run_rule(
    name = "run_red_no_system_libs",
    bin = ":probe_test",
    test_env = _NEEDS,
    toolchain = ":toolchain",
    exec_compatible_with = test_exec_compatible_with(),
)

# Red by design: libsqlite alone, without the library it needs.
mojo_test_run_rule(
    name = "run_red_one_missing",
    bin = ":probe_test",
    system_libs = [":libsqlite"],
    test_env = _NEEDS,
    toolchain = ":toolchain",
    exec_compatible_with = test_exec_compatible_with(),
)

gate_fixture_lib(name = "compiled", package = "pinned")

mojo_gated_lib_rule(
    name = "lib_exports",
    lib = ":compiled",
    package = "pinned",
    system_libs = [":libsqlite", ":libzlib"],
    exec_compatible_with = LINUX_X86_64,
)

mojo_gated_lib_rule(
    name = "lib_exports_none",
    lib = ":compiled",
    package = "pinned",
    exec_compatible_with = LINUX_X86_64,
)

exported_system_lib(name = "via_lib_0", lib = ":lib_exports", index = 0)

exported_system_lib(name = "via_lib_1", lib = ":lib_exports", index = 1)

exported_system_lib(name = "via_none_0", lib = ":lib_exports_none", index = 0)

exported_system_lib(name = "via_none_1", lib = ":lib_exports_none", index = 1)

mojo_test_run_rule(
    name = "run_green_via_lib",
    bin = ":probe_test",
    system_libs = [":via_lib_0", ":via_lib_1"],
    test_env = _NEEDS,
    toolchain = ":toolchain",
    exec_compatible_with = test_exec_compatible_with(),
    visibility = ["//ci:"],
)

# Red by design: the directories of a gated library that exports none.
mojo_test_run_rule(
    name = "run_red_via_lib_without",
    bin = ":probe_test",
    system_libs = [":via_none_0", ":via_none_1"],
    test_env = _NEEDS,
    toolchain = ":toolchain",
    exec_compatible_with = test_exec_compatible_with(),
)

scrub_files()
