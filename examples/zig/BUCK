load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/zig:zig.bzl", "zig_exe", "zig_module", "zig_test")

# The unit tests run as a build action on the farm; the executable exists only if they passed.
zig_test(
    name = "hello_unit",
    src = "hello_test.zig",
    imports = ["hello.zig"],
    visibility = ["PUBLIC"],
)

zig_exe(
    name = "hello_zig",
    src = "main.zig",
    imports = ["hello.zig"],
    unit_tests = [":hello_unit"],
    visibility = ["PUBLIC"],
)

# The same sources on the other pinned zig: the rules default to 0.12.0 (the oldest pinned), `zig_next` is 0.15.2.
# `//ci:matrix` builds both.
zig_test(
    name = "hello_unit_next",
    src = "hello_test.zig",
    imports = ["hello.zig"],
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["PUBLIC"],
)

zig_exe(
    name = "hello_zig_next",
    src = "main.zig",
    imports = ["hello.zig"],
    unit_tests = [":hello_unit_next"],
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["PUBLIC"],
)

scrub_files()
