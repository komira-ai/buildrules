load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# A workspace with a crates.io dependency that has a build script and a native library (zstd-safe -> zstd-sys -> cc, pkg-config), as a
# repository of its own: this directory is the cell `crates` (the root .buckconfig), so the generated glue (`//:buildrules.bzl`,
# `//third_party/buildrules`) is exactly what `buildrules sync` writes in any repository.
#
#   buck2 build //:ci                    lint and test the member; the build script runs as a cached remote action
#   buck2 build //:sync_check            red unless the generated files are what `buildrules sync` writes now (on the farm, no network)
#   buck2 build //:sync --out .         regenerate after a change to a Cargo.toml or Cargo.lock: writes the files the sync changed (on the farm)
load("@buildrules//rules/core:platform.bzl", "LINUX_X86_64")
load("@buildrules//rules/rust:sync.bzl", "cargo_sync")
load("@buildrules//rules/zig:zig.bzl", "zig_test")
load("//:buildrules.bzl", "cargo_workspace")

cargo_workspace(path = ".")

# ---- the sync, on the farm ------------------------------------------------------------------------------------------------
# A farm action has no network: the sync lists the packages Cargo.lock pins, buck2 downloads each `.crate` by the sha256 Cargo.lock records, and
# cargo reads them in place of crates.io (rules/rust/sync.bzl). Every id cargo prints is still crates.io's.
_WORKSPACE = ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "BUCK", "buildrules.bzl", "buildrules.lock.bzl"] + glob(["toolchains/**"])

[
    cargo_sync(
        name = name,
        check = check,
        rustc = "1.95.0",
        deps = ["//crates/covdemo:sources", "//crates/linked:sources", "//crates/linkuser:sources", "//crates/macros:sources", "//crates/pgdemo:sources", "//crates/protos:sources", "//crates/selfdev:sources", "//crates/stamped:sources", "//crates/zdemo:sources", "//third_party/buildrules:files"],
        srcs = _WORKSPACE,
        visibility = ["PUBLIC"],
    )
    for name, check in [("sync", False), ("sync_check", True)]
]

# ---- code intelligence ----------------------------------------------------------------------------------------------------
# rust-analyzer on this workspace, from what `buildrules rust-project develop` writes (rust_analyzer_test.zig): its inputs (`:rust_analyzer_inputs`,
# which cargo_workspace declares) are built by the farm, and the pinned rust-analyzer in them runs on the farm too.
zig_test(
    name = "rust_analyzer_test",
    exec_compatible_with = LINUX_X86_64,
    src = "rust_analyzer_test.zig",
    data = {
        "buildrules.lock.bzl": "buildrules.lock.bzl",
        "crates/covdemo": "//crates/covdemo:sources",
        "crates/linked": "//crates/linked:sources",
        "crates/linkuser": "//crates/linkuser:sources",
        "crates/macros": "//crates/macros:sources",
        "crates/pgdemo": "//crates/pgdemo:sources",
        "crates/protos": "//crates/protos:sources",
        "crates/selfdev": "//crates/selfdev:sources",
        "crates/stamped": "//crates/stamped:sources",
        "crates/zdemo": "//crates/zdemo:sources",
        "shared/stamp.rs": "//shared:stamp.rs",
    },
    env_tools = {"RA_INPUTS": ":rust_analyzer_inputs"},
    exec_tools = {"BUILDRULES": "buildrules//cli:buildrules"},
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["PUBLIC"],
)

# A diagnostics run (a member's `:flycheck` is made of them) of code with an error: built, and holding the error (flycheck_test.zig).
zig_test(
    name = "flycheck_test",
    exec_compatible_with = LINUX_X86_64,
    src = "flycheck_test.zig",
    data = {"diagnostics.json": "//shared:diag_fixture"},
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["PUBLIC"],
)

scrub_files()
