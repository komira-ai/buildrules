load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
# A workspace with a crates.io dependency that has a build script and a native library (zstd-safe -> zstd-sys -> cc, pkg-config), as a
# repository of its own: this directory is the cell `crates` (the root .buckconfig), so the generated glue (`//:buildrules.bzl`,
# `//third_party/buildrules`) is exactly what `buildrules sync` writes in any repository.
#
#   buck2 build //:ci                    lint and test the member; the build script runs as a cached remote action
#   buck2 build //:sync_check            red unless the generated files are what `buildrules sync` writes now (on the farm, no network)
#   buck2 build //:sync --show-full-output   regenerate: the directory holds the files to copy back (after a change to a Cargo.toml)
load("@buildrules//rules/core:pinned_file.bzl", "pinned_file")
load("@buildrules//rules/rust:sync.bzl", "cargo_sync")
load("//:buildrules.bzl", "cargo_workspace")

cargo_workspace(path = ".")

# ---- the sync, on the farm ------------------------------------------------------------------------------------------------
# A farm action has no network, so cargo resolves against a local registry: the index lines of the crates below (registry/index, as crates.io
# serves them) and the `.crate` files, downloaded by sha256 like any other pin. Every id cargo prints is still crates.io's. The sha256 and size
# of each crate are the ones in Cargo.lock and in third_party/buildrules/crate_sizes.tsv.
_CRATES = {
    "cc-1.0.83": ("f1174fb0b6ec23863f8b971027804a42614e347eafb0a95bf0b12cdae21fc4d0", 68343),
    "jobserver-0.1.27": ("8c37f63953c4c63420ed5fd3d6d398c719489b9f872b9fa683262f8edd363c7d", 24774),
    "libc-0.2.150": ("89d92a4743f9a61002fae18374ed11e7973f530cb3a3255fb354818118b2203c", 719359),
    "pkg-config-0.3.28": ("69d3587f8a9e599cc7ec2c00e331f71c4e69a5f9a4b8a6efd5b07466b9736f9a", 20330),
    "zstd-safe-7.0.0": ("43747c7422e2924c11144d5229878b98180ef8b06cca4ab5af37afc8a8d8ea3e", 20463),
    "zstd-sys-2.0.9+zstd.1.5.5": ("9e16efa8a874a0481a574084d34cc26fdb3b99627480f785888deb6386506656", 728791),
}

[
    pinned_file(
        name = "crate_" + k.replace("+", "_").replace(".", "_").replace("-", "_"),
        url = "https://static.crates.io/crates/{}/{}.crate".format(k.rsplit("-", 1)[0], k),
        sha256 = v[0],
        size_bytes = v[1],
    )
    for k, v in _CRATES.items()
]

_WORKSPACE = ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "BUCK", "buildrules.bzl", "buildrules.lock.bzl"] + glob(["toolchains/**"])

[
    cargo_sync(
        name = name,
        check = check,
        crates = {k + ".crate": ":crate_" + k.replace("+", "_").replace(".", "_").replace("-", "_") for k in _CRATES},
        index = glob(["registry/index/**"]),
        registry_root = "registry",
        rustc = "1.95.0",
        deps = ["//crates/zdemo:sources", "//third_party/buildrules:files"],
        srcs = _WORKSPACE,
        visibility = ["PUBLIC"],
    )
    for name, check in [("sync", False), ("sync_check", True)]
]

scrub_files()
