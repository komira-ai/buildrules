[
    pinned_file(
        name = "crate_" + k.replace("+", "_").replace(".", "_").replace("-", "_"),
        url = "https://static.crates.io/crates/{}/{}.crate".format(k.rsplit("-", 1)[0], k),
        sha256 = v[0],
        size_bytes = v[1],
    )
    for k, v in _CRATES.items()
]

_WORKSPACE = ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "BUCK", "buildrules.bzl", "buildrules.lock.bzl"] + glob(["toolchains/**"])

[
    cargo_sync(
        name = name,
        check = check,
        crates = {k + ".crate": ":crate_" + k.replace("+", "_").replace(".", "_").replace("-", "_") for k in _CRATES},
        index = glob(["registry/index/**"]),
        registry_root = "registry",
        rustc = "1.95.0",
        deps = ["//crates/macros:sources", "//crates/pgdemo:sources", "//crates/protos:sources", "//crates/stamped:sources", "//crates/zdemo:sources", "//third_party/buildrules:files"],
        srcs = _WORKSPACE,
        visibility = ["PUBLIC"],
    )
    for name, check in [("sync", False), ("sync_check", True)]
]

# ---- code intelligence ----------------------------------------------------------------------------------------------------
# rust-analyzer on this workspace, from what `buildrules rust-project develop` writes (rust_analyzer_test.zig): its inputs (`:rust_analyzer_inputs`,
# which cargo_workspace declares) are built by the farm, and the pinned rust-analyzer in them runs on the farm too.
zig_test(
    name = "rust_analyzer_test",
    exec_compatible_with = LINUX_X86_64,
    src = "rust_analyzer_test.zig",
    data = {
        "buildrules.lock.bzl": "buildrules.lock.bzl",
        "crates/macros": "//crates/macros:sources",
        "crates/pgdemo": "//crates/pgdemo:sources",
        "crates/protos": "//crates/protos:sources",
        "crates/stamped": "//crates/stamped:sources",
        "crates/zdemo": "//crates/zdemo:sources",
        "shared/stamp.rs": "//shared:stamp.rs",
    },
    env_tools = {"RA_INPUTS": ":rust_analyzer_inputs"},
    exec_tools = {"BUILDRULES": "buildrules//cli:buildrules"},
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["PUBLIC"],
)

# A diagnostics run (a member's `:flycheck` is made of them) of code with an error: built, and holding the error (flycheck_test.zig).
zig_test(
    name = "flycheck_test",
    exec_compatible_with = LINUX_X86_64,
    src = "flycheck_test.zig",
    data = {"diagnostics.json": "//shared:diag_fixture"},
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["PUBLIC"],
)

