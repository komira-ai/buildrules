load("@buildrules//rules/mojo:defs.bzl", "mojo_coverage_floor")
load("@buildrules//tools/scrub:defs.bzl", "scrub_files")

# The coverage of ../partial (60.00% of its lines) held to a floor that is not its own: one above it, one below it. Each target must fail, and say
# which way (ci/negative.bzl, COVERAGE_REDS). The floor that is exactly its coverage is ../partial/coverage_floor.txt, whose `:coverage_floor`
# is green and is built by //ci:mojo.
mojo_coverage_floor(
    name = "floor_above_the_coverage",
    coverage = "//examples/mojo/partial:coverage",
    floor = "floor_above.txt",
)

mojo_coverage_floor(
    name = "floor_below_the_coverage",
    coverage = "//examples/mojo/partial:coverage",
    floor = "floor_below.txt",
)

scrub_files()
