load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/mojo:sync.bzl", "mojo_sync")
load(":buildrules.mojo.bzl", "mojo_package")

# Only `cuser` (C) is named. The C++ library behind it comes with it, and so does the C++ runtime: `NativeLibraryInfo.cxx_runtime` and the archives of `cuser` are those of its closure.
mojo_package(
    path = ".",
    natives = {"libcuser.a": "//examples/native/cxx:cuser"},
)

mojo_sync(
    name = "sync",
    committed = ["buildrules.mojo.lock.bzl", "buildrules.mojo.bzl"],
    files = [],
    mopm = "0.0.73",
    visibility = ["//ci:"],
    workspaces = [":workspace"],
)

scrub_files()
