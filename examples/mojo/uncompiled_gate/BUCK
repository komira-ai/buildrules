load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/mojo:sync.bzl", "mojo_sync")
load(":buildrules.mojo.bzl", "mojo_package")

# The shapes `:coverage` tells apart among the functions no test compiled (rules/coverage/tools/mojo_calls.zig, mojo_gate.zig; ../uncompiled_gate_test.zig): `twice` is
# inlined and `entry` calls it; `inlined_nobody_calls` is inlined and nothing calls it; `only_here` is used only in a `comptime if False` arm of `entry`, an arm no report
# records, so it is platform-gated; `zero_callers` has no use. The test calls `entry`.
mojo_package(path = ".")

# `buildrules mojo sync` as a farm action (rules/mojo/sync.bzl): `buck2 run //examples/mojo/uncompiled_gate:sync` writes the two files a sync writes.
mojo_sync(
    name = "sync",
    committed = ["buildrules.mojo.lock.bzl", "buildrules.mojo.bzl"],
    files = ["//examples/mojo:mopm-toolchain.toml"],
    mopm = "0.0.48",
    visibility = ["//ci:"],
    workspaces = [":workspace"],
)

scrub_files()
