load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load("@buildrules//rules/mojo:sync.bzl", "mojo_sync")
load(":buildrules.mojo.bzl", "mojo_package")

# The member `example/nsshim` of examples/mojo/namespaced, with a C shim of its own (`[native.nsshim]`): its native unit is `native:example/nsshim/nsshim`, and the macro
# builds it as `:native_nsshim`, the id after the package's full name. `:conda` is `mojo-example.nsshim-0.1.0-mojo1.0.0_0.conda`, as mopm 0.0.113 names it.
mojo_package(path = ".")

# The `.conda` holds the archive that was built and tested and the library under its import name: `lib/libnsshim.a` is exactly the bytes of `:native_nsshim`, and
# `lib/mojo/nsshim.mojoc` is there.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    natives = {"libnsshim.a": ":native_nsshim"},
    package = "nsshim",
    visibility = ["//ci:"],
)

mojo_sync(
    name = "sync",
    committed = ["buildrules.mojo.lock.bzl", "buildrules.mojo.bzl"],
    files = ["//examples/mojo/namespaced:mopm-toolchain.toml"],
    mopm = "0.0.113",
    visibility = ["//ci:"],
    workspaces = [":workspace"],
)

scrub_files()
