load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("//rules/core:platform.bzl", "LINUX_X86_64")
load("//rules/zig:zig.bzl", "zig_test")
# Exports mopm-toolchain.toml. Every Mojo package below this directory carries a `:check` that compares it with the hash its table recorded
# (rules/mojo/check.bzl); `buildrules mojo sync` writes this file when the directory of the toolchain file has no BUCK file.
export_file(
    name = "mopm-toolchain.toml",
    src = "mopm-toolchain.toml" if glob(["mopm-toolchain.toml"]) else fail("mopm-toolchain.toml is required and there is no default. Create it, for example:\n\n[toolchain]\nmopm = '0.0.42'\nmojo = '1.0.0'\n"),
    visibility = ["PUBLIC"],
)

# What `:coverage` gives a consumer, held to the real outputs of five packages (coverage_records_test.zig): the count per file and the records
# it was counted from (`:coverage[reports_of_tests]`, the per-line records of the tests; `:coverage[branches_of_tests]`, their branch records; these packages call
# every function of their libraries, so the code no test compiled adds nothing to them, see `uncompiled` below) agree file by file. The branch records
# and rows of `testdata` and of the two packages whose tests link native libraries (`sys_app`: static archives, `ws`: a shared object) are held too. Needs the Mojo
# toolchain, so //ci:mojo builds it.
zig_test(
    name = "coverage_records",
    exec_compatible_with = LINUX_X86_64,
    src = "coverage_records_test.zig",
    data = {
        "reexport/coverage.txt": "//examples/mojo/reexport:coverage",
        "reexport/reports.cobertura.xml": "//examples/mojo/reexport:coverage[reports_of_tests]",
        "reexport/branches.info": "//examples/mojo/reexport:coverage[branches_of_tests]",
        "partial/coverage.txt": "//examples/mojo/partial:coverage",
        "partial/reports.cobertura.xml": "//examples/mojo/partial:coverage[reports_of_tests]",
        "partial/branches.info": "//examples/mojo/partial:coverage[branches_of_tests]",
        "sys_app/coverage.txt": "//examples/mojo/sys_app:coverage",
        "sys_app/branches.info": "//examples/mojo/sys_app:coverage[branches_of_tests]",
        "ws/coverage.txt": "//examples/mojo/ws:coverage",
        "ws/branches.info": "//examples/mojo/ws:coverage[branches_of_tests]",
        "testdata/coverage.txt": "//examples/mojo/testdata:coverage",
        "testdata/branches.info": "//examples/mojo/testdata:test_data_files__info",
    },
    zig ="buildrules//rules/pins:zig_next",
    visibility = ["//ci:"],
)

# What `:coverage` does with code no test compiled (uncompiled_test.zig): `uncompiled` has a function no test calls and a source marked `@generated`; `uncompiled_lean`
# is the same library with one test deleted. The function nobody calls is found and not hit, the deleted test takes hits away and no branch arm out of the
# denominator, the generated source is not counted, and the extra files of `:coverage[reports]` and `:coverage[branches]` hold the difference.
zig_test(
    name = "uncompiled",
    exec_compatible_with = LINUX_X86_64,
    src = "uncompiled_test.zig",
    data = {
        "full/coverage.txt": "//examples/mojo/uncompiled:coverage",
        "full/uncompiled.cobertura.xml": "//examples/mojo/uncompiled:coverage[reports_uncompiled]",
        "full/uncompiled.branches.info": "//examples/mojo/uncompiled:coverage[branches_uncompiled]",
        "lean/coverage.txt": "//examples/mojo/uncompiled_lean:coverage",
        "lean/reports_of_tests.xml": "//examples/mojo/uncompiled_lean:coverage[reports_of_tests]",
        "lean/branches_of_tests.info": "//examples/mojo/uncompiled_lean:coverage[branches_of_tests]",
        "lean/uncompiled.cobertura.xml": "//examples/mojo/uncompiled_lean:coverage[reports_uncompiled]",
        "lean/uncompiled.branches.info": "//examples/mojo/uncompiled_lean:coverage[branches_uncompiled]",
    },
    zig = "buildrules//rules/pins:zig_next",
    visibility = ["//ci:"],
)

scrub_files()
