load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load(":buildrules.mojo.bzl", "mojo_package")

# The publisher's side of the registry stand-in, as a package of its own: a `-sys` package, whose Mojo module is empty (its `__init__.mojo` has no byte)
# and which exists to ship `libbase_sys.a`. It is a workspace member of probe_sys, which needs its library.
#
# The library is a member native (`[native.base_sys]` in mopm.toml, `srcs = ["native/*.c"]`): the macro compiles the one C file with the pinned zig
# (`:native_base_sys_cxx`), archives it behind the archive checks (`:native_base_sys`), and makes `:conda`, the `.conda` a registry would serve for
# base_sys, with `lib/libbase_sys.a` in it. The `.conda`'s sha256 and size, and the sha256 of the archive in it, are in the consumer's lock
# (examples/mojo/sys_app/mopm.lock).
mojo_package(path = ".")

# The `.conda` holds the archive that was built: unpacked, `lib/libbase_sys.a` is exactly the bytes of `:native_base_sys`.
mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    natives = {"libbase_sys.a": ":native_base_sys"},
    package = "base_sys",
    visibility = ["//ci:"],
)

scrub_files()
