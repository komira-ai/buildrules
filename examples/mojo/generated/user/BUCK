load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/mojo:pack.bzl", "mojo_conda_holds")
load("@buildrules//rules/mojo:sync.bzl", "mojo_sync")
load(":buildrules.mojo.bzl", "mojo_package")

# Imports the sibling ../lib, whose library is at generated/gen_lib and not at src/gen_lib: the target of that library is `//examples/mojo/generated/lib:lib`, from the
# directory of ../lib's own mopm.toml, which the table records.
mojo_package(path = ".", conda = True)

mojo_conda_holds(
    name = "conda_holds",
    conda = ":conda",
    package = "gen_user",
    sole = True,
    depends = ["mojo-gen_lib >=0.1,<0.2"],
    visibility = ["//ci:"],
)

# `buildrules mojo sync` of both packages as a farm action (rules/mojo/sync.bzl): `:sync_check` is red unless the committed tables are what a sync writes now.
mojo_sync(
    name = "sync",
    committed = ["buildrules.mojo.lock.bzl", "buildrules.mojo.bzl"],
    files = ["//examples/mojo:mopm-toolchain.toml"],
    mopm = "0.0.48",
    packages = ["examples/mojo/generated/lib", "examples/mojo/generated/user"],
    visibility = ["//ci:"],
    workspaces = [":workspace"],
)

scrub_files()
