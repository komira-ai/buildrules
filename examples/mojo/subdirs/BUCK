load("@buildrules//tools/scrub:defs.bzl", "scrub_files")
load("@buildrules//rules/mojo:sync.bzl", "mojo_sync")
load(":buildrules.mojo.bzl", "mojo_package")

# A package committed with one unit graph per conda subdir: linux-64, linux-aarch64 and osx-arm64 (rules/mojo/subdirs.bzl). `mojo_package` chooses the
# graph, the toolchain and the directory of `:conda` by the target platform, and refuses a platform with no graph at analysis. ci/negative.bzl configures it for each
# platform and holds what was chosen. It names mopm 0.0.73 in its own mopm-toolchain.toml: the packages beside it are still synced with 0.0.48, which plans for linux-64 only.
mojo_package(path = ".", conda = True)

# `buildrules mojo sync` as a farm action (rules/mojo/sync.bzl): `buck2 run //examples/mojo/subdirs:sync` writes the lock, the glue and the toolchain table.
mojo_sync(
    name = "sync",
    committed = ["buildrules.mojo.lock.bzl", "buildrules.mojo.bzl"],
    files = [],
    mopm = "0.0.73",
    visibility = ["//ci:"],
    workspaces = [":workspace"],
)

scrub_files()
